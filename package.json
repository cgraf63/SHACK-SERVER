{
  "name": "shack-server",
  "version": "0.1.0",
  "description": "Modern amateur radio station server with REST API, WebSocket support and plugin architecture.",
  "private": true,
  "type": "module",
  "author": "HB9OM",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/public && cp -r src/public/* dist/public/",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "amateur-radio",
    "ham-radio",
    "contest",
    "logger",
    "dxcluster",
    "websocket",
    "rest-api",
    "nodejs",
    "typescript"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "pino": "^10.3.1",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

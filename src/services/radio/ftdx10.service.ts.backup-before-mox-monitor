    setPowerState(enabled: boolean): void {
        if (!this.port.isOpen) return;

        if (enabled) {
            // FTDX10 requires PS1; twice with 1–2 seconds interval.
            this.send(FTDX10_CAT.powerSwitch.on);

            setTimeout(() => {
                this.send(FTDX10_CAT.powerSwitch.on);
            }, 1200);

            return;
        }

        this.send(FTDX10_CAT.powerSwitch.off);
    }


import { SerialPort } from "serialport";
import type { RadioService } from "./radio.interface.js";
import { FTDX10_CAT } from "./ftdx10/ftdx10.cat.js";

export class Ftdx10Service implements RadioService {
    private port: SerialPort;
    private buffer = "";
    private frequency = 0;
    private frequencyB = 0;
    private mode = "UNKNOWN";
    private power = 0;
    private split = false;
    private radioPoweredOn = false;
    private smeter = 0;
    private meterAlc = 0;
    private meterPower = 0;
    private meterSwr = 0;
    private rfGain = 0;
    private afGain = 0;

    // DSP / filter status
    private filterWidth = 0;
    private filterShift = 0;

    private notch = false;
    private notchFrequency = 0;

    private contour = false;
    private contourFrequency = 0;

    private dnr = false;
    private dnrLevel = 1;

    private nb = false;
    private nbLevel = 0;

    private attenuator = "OFF";
    private attenuatorB = "OFF";

    private ipo = "IPO";
    private ipoB = "IPO";

    private roofingFilter = "---";
    private roofingFilterB = "---";

    private agc = "AUTO";
    private agcB = "AUTO";
    private activeVfo = "A";
    private modeB = "UNKNOWN";

    private cwMemories: string[] = [
        "",
        "",
        "",
        "",
        "",
    ];

    constructor(
        private readonly device: string,
        private readonly baudRate: number
    ) {
        this.port = new SerialPort({
            path: device,
            baudRate,
            dataBits: 8,
            stopBits: 1,
            parity: "none",
            autoOpen: false,
	    rtscts: false,
        });

        this.port.on("data", (data: Buffer) => {
            this.handleData(data.toString());
        });

        this.port.on("error", (error) => {
            console.error("FTDX10 CAT error:", error.message);
        });

        this.port.on("open", () => {
            console.log(
                `FTDX10 CAT connected: ${this.device} @ ${this.baudRate}`
            );
        });

        this.port.on("close", () => {
            console.log("FTDX10 CAT disconnected");
        });
    }



    isConnected(): boolean {
        return this.port.isOpen;
    }

    start(): void {
        if (!this.device) {
            console.log("FTDX10: no CAT device configured");
            return;
        }

        if (this.port.isOpen) {
            return;
        }

        this.port.open((error) => {
            if (error) {
                console.error(
                    "FTDX10 CAT open error:",
                    error.message
                );
                return;
            }

            this.poll();

            setInterval(() => {
                this.poll();
            }, 1000);
        });
    }

    private poll(): void {
        this.send(FTDX10_CAT.vfoA.get);
        this.send(FTDX10_CAT.vfoB.get);
        this.send("VS;");
        this.send("IF;");
        this.send("OI;");
        this.send(FTDX10_CAT.powerSwitch.get);
        this.send(FTDX10_CAT.split.get);
        this.send(FTDX10_CAT.power.get);
        this.send(FTDX10_CAT.meters.s);
        this.send(FTDX10_CAT.meters.alc);
        this.send(FTDX10_CAT.meters.power);
        this.send(FTDX10_CAT.meters.swr);
        this.send("RG0;");
        this.send("AG0;");

        // Filter / DSP status
        this.send(FTDX10_CAT.filter.width.get);
        this.send(FTDX10_CAT.filter.ifShift.get);
        this.send(FTDX10_CAT.notch.manual.get);
        this.send("BP01;");
        this.send(FTDX10_CAT.contour.get);
        this.send("CO01;");
        this.send(FTDX10_CAT.noiseReduction.get);
        this.send(FTDX10_CAT.noiseReduction.levelGet);
        this.send(FTDX10_CAT.noiseBlanker.get);
        this.send(FTDX10_CAT.noiseBlanker.levelGet);

        // Read-only receiver status.
        // Wait briefly so the VS response is processed first.
        setTimeout(() => {
            this.send(FTDX10_CAT.attenuator.get);
            this.send(FTDX10_CAT.ipo.get);
            this.send(FTDX10_CAT.agc.get);
        }, 50);

        this.send(FTDX10_CAT.cwMemory.get(1));
        this.send(FTDX10_CAT.cwMemory.get(2));
        this.send(FTDX10_CAT.cwMemory.get(3));
        this.send(FTDX10_CAT.cwMemory.get(4));
        this.send(FTDX10_CAT.cwMemory.get(5));
    }

    private send(command: string): void {
        if (!this.port.isOpen) {
            return;
        }

        this.port.write(command);
    }

    private handleData(data: string): void {
        this.buffer += data;

        let endIndex: number;

        while ((endIndex = this.buffer.indexOf(";")) !== -1) {
            const message = this.buffer.slice(0, endIndex + 1);

            this.buffer = this.buffer.slice(endIndex + 1);

            if (
                message.startsWith("SH") ||
                message.startsWith("IS") ||
                message.startsWith("BP") ||
                message.startsWith("CO") ||
                message.startsWith("NR") ||
                message.startsWith("RL") ||
                message.startsWith("NB") ||
                message.startsWith("NL")
            ) {
                console.log("FTDX10 FILTER:", message);
            }

            console.log("FTDX10 CAT RX:", message);
            this.parseResponse(message);
        }
    }

    private parseResponse(message: string): void {
        if (message.startsWith("FA")) {
            this.parseFrequency(message);
            return;
        }

        if (message.startsWith("FB")) {
            this.parseFrequencyB(message);
            return;
        }

        if (message.startsWith("PC")) {
            this.parsePower(message);
            return;
        }

        if (message.startsWith("RG")) {
            this.parseRfGain(message);
            return;
        }

        if (message.startsWith("AG")) {
            this.parseAfGain(message);
            return;
        }

        if (message.startsWith("SH")) {
            this.parseFilterWidth(message);
            return;
        }

        if (message.startsWith("IS")) {
            this.parseFilterShift(message);
            return;
        }

        if (message.startsWith("BP")) {
            this.parseNotch(message);
            return;
        }

        if (message.startsWith("CO")) {
            this.parseContour(message);
            return;
        }

        if (message.startsWith("NR")) {
            this.parseDnr(message);
            return;
        }

        if (message.startsWith("RL")) {
            this.parseDnrLevel(message);
            return;
        }

        if (message.startsWith("NB")) {
            this.parseNb(message);
            return;
        }

        if (message.startsWith("NL")) {
            this.parseNbLevel(message);
            return;
        }

        if (message.startsWith("IF")) {
            this.parseIF(message);
            return;
        }

        if (message.startsWith("OI")) {
            this.parseOI(message);
            return;
        }

        if (message.startsWith("PS")) {
            this.parsePowerSwitch(message);
            return;
        }

        if (message.startsWith("ST")) {
            this.parseSplit(message);
            return;
        }

        if (message.startsWith("SM0")) {
            this.parseSMeter(message);
            return;
        }

        if (/^RM1/.test(message)) {
            this.parseMeter(message, "smeter");
            return;
        }

        if (/^RM4/.test(message)) {
            this.parseMeter(message, "alc");
            return;
        }

        if (/^RM5/.test(message)) {
            this.parseMeter(message, "power");
            return;
        }

        if (/^RM6/.test(message)) {
            this.parseMeter(message, "swr");
            return;
        }

        if (message.startsWith("VS")) {
            this.parseActiveVfo(message);
            return;
        }

        if (message.startsWith("RA0")) {
            this.parseAttenuator(message);
            return;
        }

        if (message.startsWith("PA0")) {
            this.parseIpo(message);
            return;
        }

        if (message.startsWith("RF0")) {
            this.parseRoofingFilter(message);
            return;
        }

        if (message.startsWith("GT0")) {
            this.parseAgc(message);
            return;
        }

        if (/^KM[1-5]/.test(message)) {
            this.parseCwMemory(message);
            return;
        }
    }

    private parseActiveVfo(message: string): void {
        const match = message.match(/^VS([01]);$/);

        if (!match) {
            return;
        }

        this.activeVfo = match[1] === "0" ? "A" : "B";
    }

    private parseAttenuator(message: string): void {
        const match = message.match(/^RA0([0-3]);$/);

        if (!match) {
            return;
        }

        const values: Record<string, string> = {
            "0": "OFF",
            "1": "6 dB",
            "2": "12 dB",
            "3": "18 dB",
        };

        const value = values[match[1] ?? ""] ?? "---";

        if (this.activeVfo === "A") {
            this.attenuator = value;
        } else {
            this.attenuatorB = value;
        }
    }

    private parseIpo(message: string): void {
        const match = message.match(/^PA0([0-2]);$/);

        if (!match) {
            return;
        }

        const values: Record<string, string> = {
            "0": "IPO",
            "1": "AMP1",
            "2": "AMP2",
        };

        const value = values[match[1] ?? ""] ?? "---";

        if (this.activeVfo === "A") {
            this.ipo = value;
        } else {
            this.ipoB = value;
        }
    }

    private parseRoofingFilter(message: string): void {
        const match = message.match(/^RF0(.+);$/);

        if (!match) {
            return;
        }

        const values: Record<string, string> = {
            "9": "500 Hz",
            "7": "3 kHz",
            "6": "12 kHz",
        };

        const value =
            values[match[1] ?? ""] ?? (match[1] ?? "---");

        if (this.activeVfo === "A") {
            this.roofingFilter = value;
        } else {
            this.roofingFilterB = value;
        }
    }

    private parseAgc(message: string): void {
        const match = message.match(/^GT0([0-6]);$/);

        if (!match) {
            return;
        }

        const values: Record<string, string> = {
            "0": "OFF",
            "1": "FAST",
            "2": "MID",
            "3": "SLOW",
            "4": "AUTO",
            "5": "AUTO",
            "6": "AUTO",
        };

        const value = values[match[1] ?? ""] ?? "---";

        if (this.activeVfo === "A") {
            this.agc = value;
        } else {
            this.agcB = value;
        }
    }

    private parseCwMemory(message: string): void {
        const match = message.match(/^KM([1-5])(.*);$/);

        if (!match) {
            return;
        }

        const index = Number(match[1]) - 1;
        const text = match[2]?.trim() ?? "";

        if (index >= 0 && index < 5) {
            this.cwMemories[index] = text;
        }
    }

    private parseFrequency(message: string): void {
        const match = message.match(/^FA(\d{9});$/);

        if (!match) {
            return;
        }

        this.frequency = Number(match[1]);
    }

    private parseFrequencyB(message: string): void {
        const match = message.match(/^FB(\d{9});$/);

        if (!match) {
            return;
        }

        this.frequencyB = Number(match[1]);
    }

    private parsePower(message: string): void {
        const match = message.match(/^PC(\d{3});$/);

        if (!match) {
            return;
        }

        this.power = Number(match[1]);
    }

    private parseRfGain(message: string): void {

        const match = message.match(/^RG0(\d{3});$/);


        if (!match) {
            return;
        }

        this.rfGain = Number(match[1]);

    }

    private parseAfGain(message: string): void {
        const match = message.match(/^AG0(\d{3});$/);

        if (!match) {
            return;
        }

        this.afGain = Number(match[1]);
    }

    private parseSMeter(message: string): void {
        const match = message.match(/^SM0(\d{3});$/);

        if (!match) {
            return;
        }

        this.smeter = Number(match[1]);
    }

    private parseMeter(
        message: string,
        type: "smeter" | "alc" | "power" | "swr"
    ): void {
        const match = message.match(/^RM[1456](\d{3})(\d{3});$/);

        if (!match) {
            return;
        }

        const value = Number(match[1]);

        switch (type) {
            case "smeter":
                this.smeter = value;
                break;

            case "alc":
                this.meterAlc = value;
                break;

            case "power":
                this.meterPower = value;
                break;

            case "swr":
                this.meterSwr = value;
                break;
        }
    }

    private parseIF(message: string): void {
        /*
         * FTDX10 example:
         *
         * IF006018244780+000000200000;
         *
         * The mode field is part of the IF response.
         */

        const match = message.match(
            /^IF\d{12}[+-]\d{6}([0-9A-F])\d{5};$/
        );

        if (!match) {
            return;
        }

        const modeCode = match[1];

        if (modeCode === undefined) {
            return;
        }

        this.mode = this.decodeMode(modeCode);
    }

    private parseOI(message: string): void {
        /*
         * OI = VFO-B information.
         * The mode field is at the same position as in IF.
         */

        const match = message.match(
            /^OI\d{12}[+-]\d{6}([0-9A-F])\d{5};$/
        );

        if (!match) {
            return;
        }

        const modeCode = match[1];

        if (modeCode === undefined) {
            return;
        }

        this.modeB = this.decodeMode(modeCode);
    }

    private parseModeMain(message: string): void {
        const match = message.match(/^MD0([0-9A-F]);$/);

        if (!match) {
            return;
        }

        this.mode = this.decodeMode(match[1] ?? "");
    }

    private parseModeB(message: string): void {
        const match = message.match(/^MD1([0-9A-F]);$/);

        if (!match) {
            return;
        }

        this.modeB = this.decodeMode(match[1] ?? "");
    }

    private parsePowerSwitch(message: string): void {
        if (message === "PS0;") {
            this.radioPoweredOn = false;
            return;
        }

        if (message === "PS1;") {
            this.radioPoweredOn = true;
        }
    }

    private parseSplit(message: string): void {
        if (message === "ST0;") {
            this.split = false;
            return;
        }

        if (message === "ST1;") {
            this.split = true;
        }
    }

    private decodeMode(code: string): string {
        const modes: Record<string, string> = {
            "1": "LSB",
            "2": "USB",
            "3": "CW-U",
            "4": "FM",
            "5": "AM",
            "6": "RTTY-L",
            "7": "CW-L",
            "8": "DATA-L",
            "9": "RTTY-U",
            A: "DATA-FM",
            B: "FM-N",
            C: "DATA-U",
            D: "AM-N",
            E: "PSK",
            F: "DATA-FM-N",
        };

        return modes[code] ?? "UNKNOWN";
    }

    setActiveVfo(vfo: "A" | "B"): void {
        if (vfo === "A") {
            this.send(FTDX10_CAT.vfo.selectA);
        } else {
            this.send(FTDX10_CAT.vfo.selectB);
        }
    }

setFrequency(frequency: number): void {
    if (!Number.isFinite(frequency)) {
        throw new Error("Invalid frequency");
    }

    const value = Math.round(frequency);

    if (value < 30000 || value > 75000000) {
        throw new Error("Frequency out of range");
    }

    this.send(FTDX10_CAT.vfoA.set(value));

    this.frequency = value;
}

setFrequencyA(frequency: number): void {
    if (!Number.isFinite(frequency)) {
        throw new Error("Invalid frequency");
    }

    const value = Math.round(frequency);

    if (value < 30000 || value > 75000000) {
        throw new Error("Frequency out of range");
    }

    this.send(FTDX10_CAT.vfoA.set(value));

    this.frequency = value;
}

setFrequencyB(frequency: number): void {
    if (!Number.isFinite(frequency)) {
        throw new Error("Invalid frequency");
    }

    const value = Math.round(frequency);

    if (value < 30000 || value > 75000000) {
        throw new Error("Frequency out of range");
    }

    this.send(FTDX10_CAT.vfoB.set(value));

    this.frequencyB = value;
}
    setBand(code: string, vfo: "A" | "B"): void {
        const allowedCodes = [
            "00",
            "01",
            "02",
            "03",
            "04",
            "05",
            "06",
            "07",
            "08",
            "09",
            "10",
            "11",
            "12"
        ];

        if (!allowedCodes.includes(code)) {
            throw new Error(
                `Unsupported FTDX10 band code: ${code}`
            );
        }

        this.setActiveVfo(vfo);

        this.send(
            FTDX10_CAT.band.set(code)
        );
    }

    setAttenuator(value: 0 | 1 | 2 | 3): void {
        this.send(FTDX10_CAT.attenuator.set(value));
    }

    setIpo(value: 0 | 1 | 2): void {
        this.send(FTDX10_CAT.ipo.set(value));
    }

    setRoofingFilter(value: "9" | "7" | "6"): void {
        this.send(FTDX10_CAT.filter.roofing.set(value));
    }

    setAgc(value: number): void {
        const mode = Math.max(0, Math.min(6, Math.round(value)));
        this.send(FTDX10_CAT.agc.set(mode));
    }

    setRfGain(value: number): void {
        const gain = Math.max(
            0,
            Math.min(255, Math.round(value))
        );

        this.send(
            FTDX10_CAT.rfGain.set(gain)
        );
    }

    setAfGain(value: number): void {
        const gain = Math.max(
            0,
            Math.min(255, Math.round(value))
        );

        this.send(
            FTDX10_CAT.afGain.set(gain)
        );
    }

    setFilterWidth(code: number): void {
        const widthCode = Math.max(
            0,
            Math.min(23, Math.round(code))
        );

        this.send(
            FTDX10_CAT.filter.width.set(widthCode)
        );
    }

    setFilterShift(value: number): void {
        const shift = Math.max(
            -1200,
            Math.min(
                1200,
                Math.round(value / 20) * 20
            )
        );

        this.send(
            FTDX10_CAT.filter.ifShift.set(shift)
        );
    }

    setNotch(enabled: boolean, frequency?: number): void {
        if (!enabled) {
            this.send(FTDX10_CAT.notch.manual.off);
            return;
        }

        const hz = Math.max(
            10,
            Math.min(
                3200,
                Math.round(
                    Number(
                        frequency ??
                        this.notchFrequency ??
                        1500
                    )
                )
            )
        );

        this.send("BP00001;");

        this.send(
            FTDX10_CAT.notch.manual.on(hz)
        );
    }

    setNotchFrequency(frequency: number): void {
        const hz = Math.max(
            10,
            Math.min(
                3200,
                Math.round(frequency)
            )
        );

        this.send(
            FTDX10_CAT.notch.manual.on(hz)
        );
    }

    setContour(enabled: boolean, frequency?: number): void {
        if (!enabled) {
            this.send(
                FTDX10_CAT.contour.off
            );
            return;
        }

        const hz = Math.max(
            10,
            Math.min(
                3200,
                Math.round(
                    Number(
                        frequency ??
                        this.contourFrequency ??
                        1500
                    )
                )
            )
        );

        this.send("CO000001;");

        this.send(
            FTDX10_CAT.contour.on(hz)
        );
    }

    setContourFrequency(frequency: number): void {
        const hz = Math.max(
            10,
            Math.min(
                3200,
                Math.round(frequency)
            )
        );

        this.send(
            FTDX10_CAT.contour.on(hz)
        );
    }

    setDnr(enabled: boolean): void {
        this.send(
            enabled
                ? FTDX10_CAT.noiseReduction.on
                : FTDX10_CAT.noiseReduction.off
        );
    }

    setDnrLevel(level: number): void {
        const value = Math.max(
            1,
            Math.min(15, Math.round(level))
        );

        this.send(
            FTDX10_CAT.noiseReduction.levelSet(value)
        );
    }

    setNb(enabled: boolean): void {
        this.send(
            enabled
                ? FTDX10_CAT.noiseBlanker.on
                : FTDX10_CAT.noiseBlanker.off
        );
    }

    setNbLevel(level: number): void {
        const value = Math.max(
            0,
            Math.min(10, Math.round(level))
        );

        this.send(
            FTDX10_CAT.noiseBlanker.levelSet(value)
        );
    }

    setMode(mode: string, _frequency: number): void {
        const modes: Record<string, string> = {
            LSB: "1",
            USB: "2",
            "CW-U": "3",
            FM: "4",
            AM: "5",
            "RTTY-L": "6",
            "CW-L": "7",
            "DATA-L": "8",
            "RTTY-U": "9",
            "DATA-FM": "A",
            "FM-N": "B",
            "DATA-U": "C",
            "AM-N": "D",
            PSK: "E",
            "DATA-FM-N": "F",
        };

        const normalizedMode = mode.toUpperCase();
        const code = modes[normalizedMode];

        if (code === undefined) {
            throw new Error(
                `Unsupported FTDX10 mode: ${mode}`
            );
        }

        this.send(FTDX10_CAT.mode.set(code));

        this.mode = normalizedMode;
    }

    async playCwMemory(
        memory: number
    ): Promise<boolean> {

        if (!this.port.isOpen) {
            return false;
        }

        const commands: Record<number, string> = {
            1: "KY6;",
            2: "KY7;",
            3: "KY8;",
            4: "KY9;",
            5: "KYA;",
        };

        const command = commands[memory];

        if (!command) {
            return false;
        }

        console.log(
            "FTDX10: playing CW memory",
            memory
        );

        this.send(command);

        return true;
    }

    async tune(): Promise<boolean> {
        if (!this.port.isOpen) {
            return false;
        }

        console.log("FTDX10: starting tuner");

        this.send(FTDX10_CAT.tuner.start);

        await new Promise<void>(
            resolve => setTimeout(resolve, 5000)
        );

        console.log("FTDX10: tuner wait finished");

        return true;
    }

    private parseFilterWidth(message: string): void {
        const match = message.match(/^SH(\d{4});$/);
        if (!match) return;

        this.filterWidth = Number(match[1]);
    }

    private parseFilterShift(message: string): void {
        const match = message.match(/^IS00([+-])(\d{4});$/);
        if (!match) return;

        const value = Number(match[2]);
        this.filterShift = match[1] === "-" ? -value : value;
    }

    private parseNotch(message: string): void {
        const status = message.match(/^BP0000([01]);$/);
        if (status) {
            this.notch = status[1] === "1";
            return;
        }

        const frequency = message.match(/^BP01(\d{3});$/);
        if (frequency) {
            this.notchFrequency = Number(frequency[1]) * 10;
        }
    }

    private parseContour(message: string): void {
        const status = message.match(/^CO00000([01]);$/);
        if (status) {
            this.contour = status[1] === "1";
            return;
        }

        const frequency = message.match(/^CO01(\d{4});$/);
        if (frequency) {
            this.contourFrequency = Number(frequency[1]);
        }
    }

    private parseDnr(message: string): void {
        const match = message.match(/^NR0([01]);$/);
        if (!match) return;

        this.dnr = match[1] === "1";
    }

    private parseDnrLevel(message: string): void {
        const match = message.match(/^RL0(\d{2});$/);
        if (!match) return;

        this.dnrLevel = Number(match[1]);
    }

    private parseNb(message: string): void {
        const match = message.match(/^NB0([01]);$/);
        if (!match) return;

        this.nb = match[1] === "1";
    }

    private parseNbLevel(message: string): void {
        const match = message.match(/^NL0(\d{3});$/);
        if (!match) return;

        this.nbLevel = Number(match[1]);
    }

	setPtt(enabled: boolean): void {
    		if (!this.port.isOpen) {
        	return;
    }

    this.send(
        enabled
            ? FTDX10_CAT.ptt.on
            : FTDX10_CAT.ptt.off
    );
}

    setSplit(enabled: boolean): void {
        if (!this.port.isOpen) {
            return;
        }

        this.send(
            enabled
                ? FTDX10_CAT.split.on
                : FTDX10_CAT.split.off
        );

        this.split = enabled;
    }


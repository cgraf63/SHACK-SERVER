import { WebSocketServer, WebSocket } from "ws";
import type { Server } from "node:http";
import { spawn, type ChildProcessByStdio } from "node:child_process";
import type { Readable } from "node:stream";

import { shackSettings } from "../../config/settings.config.js";


let audioProcess:
    ChildProcessByStdio<null, Readable, Readable> | null = null;


const clients =
    new Set<WebSocket>();


function startAudioCapture(): void {

    if (audioProcess) {
        return;
    }

    if (!shackSettings.audio.enabled) {

        console.log(
            "AUDIO: disabled by configuration"
        );

        return;
    }

    const {
        device,
        sampleRate,
        channels
    } = shackSettings.audio;


    console.log(
        `AUDIO: starting capture ${device} ${sampleRate}Hz ${channels}ch`
    );


    const process =
        spawn(
            "arecord",
            [
                "-D", device,
                "-f", "S16_LE",
                "-r", String(sampleRate),
                "-c", String(channels),
                "-t", "raw"
            ],
            {
                stdio: [
                    "ignore",
                    "pipe",
                    "pipe"
                ]
            }
        );

    audioProcess = process;


    process.stdout.on(
        "data",
        (chunk: Buffer) => {

            for (const client of clients) {

                if (
                    client.readyState ===
                    WebSocket.OPEN
                ) {

                    client.send(chunk);

                }

            }

        }
    );


    process.stderr.on(
        "data",
        (chunk: Buffer) => {

            const message =
                chunk.toString().trim();

            if (message) {
                console.log(
                    `AUDIO: ${message}`
                );
            }

        }
    );


    process.on(
        "error",
        (error) => {

            console.error(
                "AUDIO: capture error",
                error
            );

            audioProcess = null;

        }
    );


    process.on(
        "close",
        (code, signal) => {

            console.log(
                `AUDIO: capture stopped (code=${code}, signal=${signal})`
            );

            audioProcess = null;

        }
    );

}


function stopAudioCapture(): void {

    if (!audioProcess) {
        return;
    }

    console.log(
        "AUDIO: stopping capture"
    );

    audioProcess.kill("SIGTERM");

}


export function startAudioWebSocket(
    server: Server
): void {

    const wss =
        new WebSocketServer({
            server,
            path: "/audio"
        });


    wss.on(
        "connection",
        (socket) => {

            console.log(
                "AUDIO WS: client connected"
            );


            clients.add(socket);


            if (clients.size === 1) {
                startAudioCapture();
            }


            socket.on(
                "close",
                () => {

                    clients.delete(socket);


                    console.log(
                        "AUDIO WS: client disconnected"
                    );


                    if (clients.size === 0) {
                        stopAudioCapture();
                    }

                }
            );


            socket.on(
                "error",
                () => {

                    clients.delete(socket);

                    if (clients.size === 0) {
                        stopAudioCapture();
                    }

                }
            );

        }
    );


    console.log(
        "AUDIO WS: listening on /audio"
    );

}


/* SHACK-SERVER TX AUDIO */

let txAudioProcess:
    ChildProcessByStdio<null, Readable, Readable> | null = null;

const txClients =
    new Set<WebSocket>();


function startTxAudio(): void {

    if (txAudioProcess) {
        return;
    }

    if (!shackSettings.audio.enabled) {

        console.log(
            "TX AUDIO: disabled by configuration"
        );

        return;
    }

    const {
        device,
        sampleRate,
        channels
    } = shackSettings.audio;


    console.log(
        `TX AUDIO: starting playback ${device} ${sampleRate}Hz ${channels}ch`
    );


    const process =
        spawn(
            "aplay",
            [
                "-D", device,
                "-f", "S16_LE",
                "-r", String(sampleRate),
                "-c", String(channels),
                "-t", "raw"
            ],
            {
                stdio: [
                    "pipe",
                    "ignore",
                    "pipe"
                ]
            }
        );


    txAudioProcess = process;


    process.stderr.on(
        "data",
        (chunk: Buffer) => {

            const message =
                chunk.toString().trim();

            if (message) {
                console.log(
                    `TX AUDIO: ${message}`
                );
            }

        }
    );


    process.on(
        "error",
        (error) => {

            console.error(
                "TX AUDIO: playback error",
                error
            );

            txAudioProcess = null;

        }
    );


    process.on(
        "close",
        (code, signal) => {

            console.log(
                `TX AUDIO: playback stopped (code=${code}, signal=${signal})`
            );

            txAudioProcess = null;

        }
    );

}


function stopTxAudio(): void {

    if (!txAudioProcess) {
        return;
    }

    console.log(
        "TX AUDIO: stopping playback"
    );

    txAudioProcess.kill("SIGTERM");

    txAudioProcess = null;

}


function handleTxAudioData(
    data: Buffer
): void {

    if (!txAudioProcess) {
        startTxAudio();
    }

    if (
        txAudioProcess &&
        txAudioProcess.stdin &&
        !txAudioProcess.stdin.destroyed
    ) {

        txAudioProcess.stdin.write(data);

    }

}


function startTxAudioWebSocket(
    server: Server
): void {

    const wss =
        new WebSocketServer({
            server,
            path: "/audio-tx"
        });


    wss.on(
        "connection",
        (socket) => {

            console.log(
                "TX AUDIO WS: client connected"
            );


            /*
             * Only one TX audio source at a time.
             */
            if (txClients.size > 0) {

                console.log(
                    "TX AUDIO WS: rejecting additional client"
                );

                socket.close(
                    1013,
                    "TX audio already in use"
                );

                return;

            }


            txClients.add(socket);


            socket.on(
                "message",
                (data, isBinary) => {

                    if (!isBinary) {
                        return;
                    }

                    handleTxAudioData(
                        Buffer.from(data as Buffer)
                    );

                }
            );


            socket.on(
                "close",
                () => {

                    txClients.delete(socket);

                    console.log(
                        "TX AUDIO WS: client disconnected"
                    );

                    if (txClients.size === 0) {
                        stopTxAudio();
                    }

                }
            );


            socket.on(
                "error",
                () => {

                    txClients.delete(socket);

                    if (txClients.size === 0) {
                        stopTxAudio();
                    }

                }
            );

        }
    );


    console.log(
        "TX AUDIO WS: listening on /audio-tx"
    );

}


/*
 * Start TX WebSocket alongside the existing RX WebSocket.
 */
startTxAudioWebSocket(server);


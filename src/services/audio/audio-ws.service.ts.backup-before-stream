import { WebSocketServer } from "ws";
import type { Server } from "node:http";

export function startAudioWebSocket(
    server: Server
): void {

    const wss =
        new WebSocketServer({
            server,
            path: "/audio"
        });

    wss.on(
        "connection",
        (socket) => {

            console.log(
                "AUDIO WS: client connected"
            );

            socket.on(
                "close",
                () => {

                    console.log(
                        "AUDIO WS: client disconnected"
                    );

                }
            );

        }
    );

    console.log(
        "AUDIO WS: listening on /audio"
    );
}

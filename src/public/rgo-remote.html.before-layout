<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RGO ONE Remote</title>

    <link rel="stylesheet" href="/css/rgo-remote.css">
</head>

<body>

<div class="rgo-app">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="rgo-header">

        <div class="rgo-logo">
            <span class="logo-rgo">RGO</span>
            <span class="logo-one">ONE</span>
        </div>

        <div class="rgo-subtitle">
            ALL MODE HF TRANSCEIVER
        </div>

        <div class="header-right">

            <span class="server-label">
                SHACK-SERVER REMOTE
            </span>

            <span class="connection-status">
                <span class="connection-dot"></span>
                <span class="connection-status-text">CONNECTED</span>
            </span>

        </div>

    </header>


    <!-- =====================================================
         TOP SECTION
         ===================================================== -->

    <section class="top-section">

        <!-- METER -->

        <div class="panel meter-panel">

            <div class="panel-title">METER</div>

            <div class="meter-scale">
                <span>S</span>
                <span>1</span>
                <span>3</span>
                <span>5</span>
                <span>7</span>
                <span>9</span>
                <span>+10</span>
                <span>+20</span>
                <span>+30</span>
                <span>+40</span>
                <span>+60</span>
            </div>

            <div class="meter-bar">
                <div class="meter-segments">
                    <span></span><span></span><span></span><span></span><span></span>
                    <span></span><span></span><span></span><span></span><span></span>
                    <span></span><span></span><span></span><span></span><span></span></div>
            </div>

            <div class="meter-reading">
                <strong>S9+20</strong>
                <span>-92 dBm</span>
            </div>

            <div class="meter-select">
                <button
                    class="active"
                    data-meter="S"
                >S</button>

                <button
                    data-meter="PWR"
                >PWR</button>

                <button
                    data-meter="ALC"
                >ALC</button>

                <button
                    data-meter="SWR"
                >SWR</button>

                <button
                    data-meter="COMP"
                >COMP</button>
            </div>

        </div>


        <!-- FREQUENCY -->

        <div class="frequency-area">

            <div class="mode-selector">
                <button>LSB</button>
                <button class="active">USB</button>
                <button>CW</button>
                <button>CW-R</button>
                <button>AM</button>
                <button>FM</button>
                <button>DIG</button>
            </div>

            <div class="frequency-display">

                <div class="frequency-value">
                    14.175.320
                </div>

                <span class="frequency-unit">MHz</span>

            </div>

            <div class="frequency-scale">

                <span>14.170</span>
                <span>14.172</span>
                <span>14.174</span>

                <span class="frequency-marker">
                    14.175
                </span>

                <span>14.176</span>
                <span>14.178</span>
                <span>14.180</span>

            </div>

        </div>


        <!-- VFO KNOB -->

        <div class="vfo-area">

            <div class="vfo-selector">
                <button class="active">VFO A</button>
                <button>VFO B</button>
                <button>SPLIT</button>
            </div>

            <div class="vfo-control">

                <div class="vfo-knob">

                    <div class="vfo-ring"></div>

                    <div class="vfo-marker"></div>

                    <div class="vfo-center"></div>

                </div>

                <div class="step-selector">

                    <div class="step-title">STEP</div>

                    <button>1 Hz</button>
                    <button>10 Hz</button>
                    <button class="active">100 Hz</button>
                    <button>1 kHz</button>

                </div>

            </div>

            <div class="vfo-arrows">
                <button>‹</button>
                <button>›</button>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SDR SPECTRUM / WATERFALL
         ===================================================== -->

    <section class="rgo-sdr-section">

        <div class="panel rgo-sdr-panel">

            <div class="panel-title">SDR SPECTRUM / WATERFALL</div>

            <div class="rgo-sdr-frequency">
                <span id="rgo-sdr-frequency">14.175.320</span>
                <small>MHz</small>
            </div>

            <div class="rgo-sdr-display">

                <div class="rgo-sdr-spectrum-wrap">

                    <canvas
                        id="rgo-sdr-spectrum"
                        class="rgo-sdr-spectrum"
                    ></canvas>

                    <div
                        id="rgo-sdr-vfo-marker"
                        class="rgo-sdr-vfo-marker"
                    ></div>

                </div>

                <div class="rgo-sdr-waterfall-wrap">

                    <canvas
                        id="rgo-sdr-waterfall"
                        class="rgo-sdr-waterfall"
                    ></canvas>

                </div>

            </div>

            <div class="rgo-sdr-scale">
                <span>14.000 MHz</span>
                <span>14.350 MHz</span>
            </div>

        </div>

    </section>


    <!-- =====================================================
         MIDDLE SECTION
         ===================================================== -->

    <section class="middle-section">


        <!-- VFO -->

        <div class="panel vfo-panel">

            <div class="panel-title">VFO</div>

            <div class="vfo-buttons">
                <button class="active">VFO A</button>
                <button>VFO B</button>
                <button>SPLIT</button>
            </div>

            <div class="vfo-frequency-row">
                <span>A</span>
                <strong>14.175.320</strong>
            </div>

            <div class="vfo-frequency-row">
                <span>B</span>
                <strong>7.074.000</strong>
            </div>

            <button class="swap-button">⇄</button>

        </div>


        <!-- BAND -->

        <div class="panel band-panel">

            <div class="panel-title">BAND</div>

            <div class="band-grid">
                <button class="band-indicator" data-band="160">160</button>
                <button class="band-indicator" data-band="80">80</button>
                <button class="band-indicator" data-band="60">60</button>
                <button class="band-indicator" data-band="40">40</button>

                <button class="band-indicator" data-band="30">30</button>
                <button class="band-indicator active" data-band="20">20</button>
                <button class="band-indicator" data-band="17">17</button>
                <button class="band-indicator" data-band="15">15</button>

                <button class="band-indicator" data-band="12">12</button>
                <button class="band-indicator" data-band="10">10</button>
                <button class="band-indicator" data-band="6">6</button>
            </div>

            <div class="band-control-row">
                <button
                    id="rgo-band-down"
                    class="band-control-button"
                    type="button"
                >
                    BAND DN
                </button>

                <button
                    id="rgo-band-up"
                    class="band-control-button"
                    type="button"
                >
                    BAND UP
                </button>
            </div>

        </div>


        <!-- FUNCTIONS -->

        <div class="panel functions-panel">

            <div class="panel-title">FUNCTIONS</div>

            <div class="function-grid">

                <div class="function-item">
                    <span>PREAMP</span>
                    <button class="active">ON</button>
                </div>

                <div class="function-item">
                    <span>ATT</span>
                    <button>OFF</button>
                </div>

                <div class="function-item">
                    <span>NB</span>
                    <button>OFF</button>
                </div>

                <div class="function-item agc-item">
                    <span>AGC</span>
                    <div>
                        <button class="active">FAST</button>
                        <button>SLOW</button>
                        <button>OFF</button>
                    </div>
                </div>

                <div class="function-item">
                    <span>ATU</span>
                    <button>TUNE</button>
                </div>

            </div>

        </div>


        <!-- RF / AUDIO -->

        <div class="panel levels-panel">

            <div class="panel-title">RF / AUDIO</div>

            <div class="level-row">

                <label>RF GAIN</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="70"
                >

                <output>70</output>

            </div>

            <div class="level-row">

                <label>MIC GAIN</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="7"
                >

                <output>7</output>

            </div>

            <div class="level-row">

                <label>POWER</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="50"
                >

                <output>50 W</output>

            </div>

        </div>

    </section>


    <!-- =====================================================
         BOTTOM SECTION
         ===================================================== -->

    <section class="bottom-section">


        <!-- CW -->

        <div class="panel cw-panel">

            <div class="panel-title">CW</div>

            <div class="level-row">

                <label>CW SPEED</label>

                <input
                    type="range"
                    min="4"
                    max="60"
                    value="20"
                >

                <output>20</output>

            </div>

            <div class="level-row">

                <label>BK-IN DELAY</label>

                <input
                    type="range"
                    min="0"
                    max="600"
                    value="300"
                >

                <output>300</output>

            </div>

        </div>


        <!-- RIT / XIT -->

        <div class="panel rit-panel">

            <div class="panel-title">RIT / XIT</div>

            <div class="rit-row">

                <label>OFFSET</label>

                <input
                    id="rgo-rit-xit-slider"
                    type="range"
                    min="-5000"
                    max="5000"
                    step="10"
                    value="0"
                >

                <div class="rit-offset-input">
                    <input
                        id="rgo-rit-xit-value"
                        type="number"
                        min="-5"
                        max="5"
                        step="0.01"
                        value="0.00"
                        inputmode="decimal"
                    >
                    <span>kHz</span>
                </div>

            </div>

            <div class="rit-range">
                <span>-5.00</span>
                <span>+5.00 kHz</span>
            </div>

            <button
                id="rgo-rit-xit-mode"
                class="rit-xit-mode-button"
                type="button"
            >OFF</button>

        </div>


        <!-- QUICK ACTIONS -->

        <div class="panel quick-panel">

            <div class="panel-title">QUICK ACTIONS</div>

            <div class="quick-actions">

                <button>A &gt; B</button>
                <button>B &gt; A</button>
                <button>A = B</button>

            </div>

        </div>


        <!-- INFO -->

        <div class="panel info-panel">

            <div class="panel-title">INFO</div>

            <div class="info-row">
                <span>FW</span>
                <strong>1.10</strong>
            </div>

            <div class="info-row">
                <span>SN</span>
                <strong>000123</strong>
            </div>

            <div class="info-row">
                <span>CAT</span>
                <strong>✓</strong>
            </div>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="rgo-footer">

        <div class="footer-brand">

            <div class="footer-symbol">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

            <strong>SHACK-SERVER</strong>

        </div>

        <div class="footer-tagline">
            SMALL RADIO. BIG POSSIBILITIES.
        </div>

        <div class="footer-time">
            14:27
        </div>

    </footer>

</div>

    <script src="/js/rgo-remote.js"></script>

</body>
</html>

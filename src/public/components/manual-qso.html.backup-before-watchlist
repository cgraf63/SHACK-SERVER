<div class="card manual-qso-card">

    <h2>MANUAL QSO / WATCH</h2>

    <div class="manual-qso-field">


        <div class="manual-qso-call-row">

            <input
                type="text"
                id="manual-qso-call"
                placeholder="CALLSIGN"
                autocomplete="off"
                spellcheck="false"
            >
	<button
    		type="button"
    		id="manual-qso-view"
    		class="manual-qso-qrz-button"
   		title="View Station"
		>👀</button>

            <label
                class="manual-qso-watch"
                title="Watch for live spot"
            >

                <input
                    type="checkbox"
                    id="manual-qso-watch"
                >

                <span>WATCH</span>

            </label>

            <img
                id="manual-qso-flag"
                class="manual-qso-flag"
                src=""
                alt=""
            >

        </div>

        <div
            id="manual-qso-watch-alert"
            class="manual-qso-watch-alert"
        ></div>

    </div>


    <div class="manual-qso-field">


        <input
            type="text"
            id="manual-qso-name"
            placeholder="NAME"
            autocomplete="off"
        >

    </div>


    <div class="manual-qso-row">

        <div class="manual-qso-field">


            <select id="manual-qso-band">

                <option value="">BAND</option>
                <option value="160m">160m</option>
                <option value="80m">80m</option>
                <option value="40m">40m</option>
                <option value="20m">20m</option>
                <option value="17m">17m</option>
                <option value="15m">15m</option>
                <option value="12m">12m</option>
                <option value="10m">10m</option>
                <option value="6m">6m</option>

            </select>

        </div>


        <div class="manual-qso-field">


            <select id="manual-qso-mode">

                <option value="">MODE</option>
                <option value="SSB">SSB</option>
                <option value="USB">USB</option>
                <option value="LSB">LSB</option>
                <option value="CW">CW</option>
                <option value="FT8">FT8</option>
                <option value="FT4">FT4</option>

            </select>

        </div>

    </div>


    <div class="manual-qso-field">


        <input
            type="text"
            id="manual-qso-country"
            placeholder="COUNTRY"
            autocomplete="off"
        >

    </div>


    <div class="manual-qso-row">

        <div class="manual-qso-field">

            <input
                type="number"
                id="manual-qso-itu"
                placeholder="ITU"
                min="0"
                max="90"
            >

        </div>


        <div class="manual-qso-field">


            <input
                type="number"
                id="manual-qso-cq"
                placeholder="CQ"
                min="0"
                max="40"
            >

        </div>

    </div>


    <div class="manual-qso-field manual-qso-frequency-field">


        <input
            type="text"
            id="manual-qso-frequency"
            placeholder="FREQUENCY"
            autocomplete="off"
        >

        <span class="manual-qso-frequency-unit">kHz</span>

    </div>


    <div class="manual-qso-actions">

        <button
            type="button"
            id="manual-qso-open"
            class="manual-qso-open-button"
        >
            → QSO
        </button>

    </div>

</div>

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHACK-SERVER – FTDX10 Remote</title>
    <link rel="stylesheet" href="/css/remote.css">
</head>

<body>

<header class="topbar">

    <div class="brand">
        <div class="brand-icon"><img src="/assets/shack-server-logo.svg" alt="SHACK-SERVER"></div>
        <div>
            <div class="brand-name">SHACK-SERVER</div>
            <div class="brand-sub">REMOTE RADIO CONTROL</div>
        </div>
    </div>

    <div class="header-separator"></div>

    <div class="radio-name">FTDX10</div>

    <div class="connection">
        <span class="status-dot"></span>
        CONNECTED
    </div>

    <div class="header-spacer"></div>

    <div class="operator">
        <div>HB9XXX</div>
        <div>JN47QO</div>
    </div>

    <div class="clock">
        <div>Tue, 10 Dec 2024</div>
        <strong>14:28:32 UTC</strong>
    </div>

    <div class="power-icon">⏻</div>

</header>


<main class="console">

    <!-- =========================================================
         TOP: VFO A / SPLIT / VFO B / MODE
         ========================================================= -->

    <section class="top-row">

        <!-- VFO A -->
        <div class="panel vfo-panel">

            <div class="vfo-panel-header">
                <div class="panel-title">VFO A</div>

            </div>


	    <div class="vfo-status">

    	<button class="vfo-control-badge mode-control active">
        <span class="badge-label">MODE</span>
        <span class="badge-value">USB</span>
    	</button>

    	<button class="vfo-control-badge">
        <span class="badge-label">ATT</span>
        <span class="badge-value">OFF</span>
    	</button>

    	<button class="vfo-control-badge">
        <span class="badge-label">IPO</span>
        <span class="badge-value">PREAMP</span>
    	</button>

    	<button class="vfo-control-badge">
        <span class="badge-label">R.FIL</span>
        <span class="badge-value">3 kHz</span>
    	</button>

    	<button class="vfo-control-badge">
        <span class="badge-label">AGC</span>
        <span class="badge-value">AUTO</span>
    	</button>

    	

</div>		

            <div class="frequency" id="vfo-a-frequency">14.074.000</div>

            <div class="vfo-controls">
                <select class="band-button" data-vfo="A">
    <option value="00">160 m</option>
    <option value="01">80 m</option>
    <option value="02">60 m</option>
    <option value="03">40 m</option>
    <option value="04">30 m</option>
    <option value="05" selected>20 m</option>
    <option value="06">17 m</option>
    <option value="07">15 m</option>
    <option value="08">12 m</option>
    <option value="09">10 m</option>
    <option value="10">6 m</option>
    <option value="11">GEN</option>
    <option value="12">MW</option>
</select>
            </div>

        </div>


        <!-- SPLIT -->
        <div class="panel split-panel">

            <div class="split-buttons">
                <button class="small-tx active">VFO A</button>
                <button class="small-tx">VFO B</button>
            </div>

            <button class="split-button" id="split-toggle">
                SPLIT
            </button>

            <div class="split-frequencies">
                <div class="split-frequency">
                    <span>RX</span>
                    <strong id="split-rx-frequency">14.074.000</strong>
                </div>

                <div class="split-frequency">
                    <span>TX</span>
                    <strong id="split-tx-frequency">14.079.000</strong>
                </div>
            </div>

            <div class="split-tx-control">
                <button class="split-up-button" id="split-up5">
                    UP +5
                </button>

                <input
                    id="split-tx-frequency-input"
                    type="text"
                    inputmode="decimal"
                    value="14.079.000"
                >
            </div>


        </div>


        <div class="panel vfo-panel">

            <div class="panel-title">VFO B</div>

            <div class="vfo-status">

                <button class="vfo-control-badge mode-control active">
                    <span class="badge-label">MODE</span>
                    <span class="badge-value">CW-L</span>
                </button>

                <button class="vfo-control-badge">
                    <span class="badge-label">ATT</span>
                    <span class="badge-value">OFF</span>
                </button>

                <button class="vfo-control-badge">
                    <span class="badge-label">IPO</span>
                    <span class="badge-value">PREAMP</span>
                </button>

                <button class="vfo-control-badge">
                    <span class="badge-label">R.FIL</span>
                    <span class="badge-value">3 kHz</span>
                </button>

                <button class="vfo-control-badge">
                    <span class="badge-label">AGC</span>
                    <span class="badge-value">AUTO</span>
                </button>

            </div>

            <div class="frequency" id="vfo-b-frequency">14.095.000</div>

            <div class="vfo-controls">
                <select class="band-button" data-vfo="B">
    <option value="00">160 m</option>
    <option value="01">80 m</option>
    <option value="02">60 m</option>
    <option value="03">40 m</option>
    <option value="04">30 m</option>
    <option value="05" selected>20 m</option>
    <option value="06">17 m</option>
    <option value="07">15 m</option>
    <option value="08">12 m</option>
    <option value="09">10 m</option>
    <option value="10">6 m</option>
    <option value="11">GEN</option>
    <option value="12">MW</option>
</select>
            </div>

        </div>

        

        <!-- MODE POPUP -->
        <div class="mode-popup" id="mode-popup">
            <div class="mode-popup-title">MODE</div>

            <div class="mode-popup-grid">
                <button data-mode="LSB">LSB</button>
                <button data-mode="USB">USB</button>
                <button data-mode="CW-L">CW-L</button>
                <button data-mode="CW-U">CW-U</button>

                <button data-mode="AM">AM</button>
                <button data-mode="FM">FM</button>
                <button data-mode="DATA-L">DATA-L</button>
                <button data-mode="DATA-U">DATA-U</button>

                <button data-mode="RTTY-L">RTTY-L</button>
                <button data-mode="RTTY-U">RTTY-U</button>
                <button data-mode="PKT">PKT</button>
                <button data-mode="GEN">GEN</button>
            </div>
        </div>

    </section>


    <!-- =========================================================
         METERS
         ========================================================= -->

    <section class="meter-row">

        <div class="meter panel">
            <div class="meter-title">S-METER</div>

            <div class="analog-meter">
                <div class="meter-scale">
                    <span>S1</span>
                    <span>35</span>
                    <span>5</span>
                    <span>7</span>
                    <span>9</span>
                    <span>+20</span>
                    <span>+40</span>
                    <span>+60</span>
                </div>

                <div class="meter-arc"></div>
                <div class="meter-needle"></div>
            </div>

        </div>


        <div class="meter panel">
            <div class="meter-title">POWER</div>

            <div class="analog-meter">
                <div class="meter-scale">
                    <span>0</span>
                    <span>10</span>
                    <span>50</span>
                    <span>100</span>
                </div>

                <div class="meter-arc"></div>
                <div class="meter-needle power-needle"></div>
            </div>

        </div>


        <div class="meter panel">
            <div class="meter-title">SWR</div>

            <div class="analog-meter">
                <div class="meter-scale">
                    <span>1.0</span>
                    <span>2.0</span>
                    <span>3.0</span>
                    <span>4.0</span>
                    <span>5.0</span>
                </div>

                <div class="meter-arc"></div>
                <div class="meter-needle swr-needle"></div>
            </div>

            <div class="meter-value">1.2</div>
            <div class="meter-subvalue">SWR</div>
        </div>


        <div class="meter panel">
            <div class="meter-title">ALC</div>

            <div class="analog-meter">
                <div class="meter-scale">
                    <span>0</span>
                    <span>25</span>
                    <span>50</span>
                    <span>75</span>
                    <span>100</span>
                </div>

                <div class="meter-arc"></div>
                <div class="meter-needle alc-needle"></div>
            </div>

            <div class="meter-value">35 %</div>
            <div class="meter-subvalue">&nbsp;</div>
        </div>


        <!-- TRANSMIT -->
        <div class="panel transmit-panel">

            <div class="section-title">TRANSMIT</div>

            <div class="transmit-content">

                <div class="ptt-ring">
                    <button class="ptt-button">PTT</button>
                </div>

                <div class="tx-buttons">

                    <button class="tune-button">
                        TUNE
                    </button>

                    <div class="moni-control">
                        <span>MONI</span>

                        <input
                            type="range"
                            class="moni-slider"
                            min="0"
                            max="100"
                            step="1"
                            value="50"
                        >

                        <strong class="moni-value">
                            50
                        </strong>
                    </div>

                </div>

            </div>

        </div>


    </section>


    <!-- =========================================================
         CONTROL ROW
         ========================================================= -->

    <section class="control-row">

        <!-- FILTER -->
        <div class="panel control-panel">

            <div class="section-title">FILTER</div>

            <div class="control-line">
                <label>WIDTH</label>
                <input id="filter-width" type="range" min="0" max="100" value="72">
                <span>2.4 kHz</span>
            </div>

            <div class="scale">
                <span>0.3</span>
                <span>0.6</span>
                <span>1.2</span>
                <span>2.4</span>
                <span>3.0</span>
            </div>

            <div class="control-line">
                <label>SHIFT</label>
                <input id="filter-shift" type="range" min="0" max="100" value="50">
                <span>0 Hz</span>
            </div>

            <div class="scale">
                <span>−1.2k</span>
                <span>0</span>
                <span>+1.2k</span>
            </div>

        </div>


        <!-- DSP -->
        <div class="panel control-panel dsp-panel">

            <div class="section-title">DSP</div>

            <div class="dsp-line" id="dsp-notch">
                <label>NOTCH</label>
                <button class="toggle-button">OFF</button>
                <input
                    class="dsp-slider"
                    id="notch-slider"
                    type="range"
                    min="10"
                    max="3200"
                    step="10"
                    value="1500">
                <strong>1.500 kHz</strong>
            </div>

            <div class="dsp-line" id="dsp-contour">
                <label>CONTOUR</label>
                <button class="toggle-button">OFF</button>
                <input
                    class="dsp-slider"
                    id="contour-slider"
                    type="range"
                    min="20"
                    max="3170"
                    step="10"
                    value="1500">
                <strong>1.500 kHz</strong>
            </div>

            <div class="dsp-line" id="dsp-dnr">
                <label>DNR</label>
                <button class="toggle-button">OFF</button>
                <strong>8</strong>
                <button class="value-button">−</button>
                <button class="value-button">+</button>
            </div>

            <div class="dsp-line" id="dsp-nb">
                <label>NB</label>
                <button class="toggle-button">OFF</button>
                <strong>3</strong>
                <button class="value-button">−</button>
                <button class="value-button">+</button>
            </div>

        </div>


        <!-- RF / AF -->
        <div class="panel control-panel rf-panel">

            <div class="section-title">RF / AF</div>

            <div class="slider-control">
                <label>RF GAIN</label>
                <input id="rf-gain-slider" type="range" min="0" max="100" value="50">
                <span>50</span>
            </div>

            <div class="slider-control">
                <label>AF GAIN</label>
                <input id="af-gain-slider" type="range" min="0" max="100" value="35">
                <span>35</span>
            </div>
        </div>


        <!-- QUICK FUNCTIONS -->
    <div class="panel control-panel quick-functions-panel">

        <div class="section-title">QUICK FUNCTIONS</div>

        <div class="quick-functions">

            <button
                class="quick-button"
                id="ctr2-connect"
                type="button"
            >
                CONNECT CTR2
            </button>

            <button class="quick-button" id="audio-toggle">
                Audio On
            </button>

            <button
                class="quick-button"
                id="mic-eq-button"
                type="button"
            >
                MIC EQ
            </button>

            <button
                class="quick-button"
                id="bk-in-button"
                type="button"
            >
                BK-IN
            </button>

            <div class="quick-slider">
                <div class="quick-slider-label">
                    <span>CW SPEED</span>
                    <span id="cw-speed-value">20</span>
                </div>
                <input
                    id="cw-speed-slider"
                    type="range"
                    min="4"
                    max="60"
                    value="20"
                    step="1"
                >
            </div>

            <div class="quick-slider">
                <div class="quick-slider-label">
                    <span>MIC GAIN</span>
                    <span id="mic-gain-value">50</span>
                </div>
                <input
                    id="mic-gain-slider"
                    type="range"
                    min="0"
                    max="100"
                    value="50"
                    step="1"
                >
            </div>

        </div>
    </div>

    </section>

    <!-- =========================================================
         TX POWER
         ========================================================= -->

    <section class="power-row">

        <!-- SDR WATERFALL -->
        <div class="panel control-panel sdr-waterfall-panel">

            <div class="section-title">SDR WATERFALL</div>

            <div class="sdr-waterfall-header">
                <span id="sdr-frequency">14.100.000 MHz</span>
                <span id="sdr-status">DISCONNECTED</span>
            </div>

            <div class="sdr-waterfall-container">

                <canvas
                    id="sdr-waterfall"
                    class="sdr-waterfall"
                ></canvas>

                <div
                    id="sdr-vfo-marker"
                    class="sdr-vfo-marker"
                ></div>

            </div>

            <div class="sdr-frequency-scale">
                <span>13.332 MHz</span>
                <span>14.100 MHz</span>
                <span>14.868 MHz</span>
            </div>

        </div>

        <!-- TX POWER -->
        <div class="panel power-panel">

            <div class="section-title">TX POWER</div>

            <div class="power-ring">
                <div class="power-ring-value power-number">50 W</div>
                <div class="power-ring-label">TX POWER</div>
            </div>

            <input
                class="power-slider"
                type="range"
                min="5"
                max="100"
                value="50"
            >

            <div class="slider-labels">
                <span>1</span>
                <span>5</span>
                <span>10</span>
                <span>50</span>
                <span>100</span>
            </div>

        </div>

    </section>

</main>



    <script src="/js/remote.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="de">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Contest – SHACK-SERVER</title>

    <link
        rel="icon"
        type="image/x-icon"
        href="/favicon.ico"
    >

    <link
        rel="stylesheet"
        href="css/variables.css"
    >

    <link
        rel="stylesheet"
        href="css/theme.css"
    >

    <link
        rel="stylesheet"
        href="css/layout.css"
    >

    <link
        rel="stylesheet"
        href="css/components.css"
    >

    <link
        rel="stylesheet"
        href="css/contest.css"
    >

</head>


<body>

<div id="app" class="contest-app">


    <!-- MAIN -->

    <main>


        <!-- HEADER -->

        <div id="header"></div>


        <!-- CONTEST CONSOLE -->



        <section class="contest-console">


    <!-- PAGE HEADER -->

    <div class="page-header">

        <div>

            <h1>
                Contest Console
            </h1>

        </div>

    </div>


    <!-- CONTEST NAVIGATION -->

    <nav class="contest-tabs" aria-label="Contest navigation">

        <button
            type="button"
            class="contest-tab active"
            data-contest-view="console"
        >
            CONSOLE
        </button>

        <button
            type="button"
            class="contest-tab"
            data-contest-view="qsos"
        >
            QSOs
        </button>

        <button
            type="button"
            class="contest-tab"
            data-contest-view="sessions"
        >
            SESSIONS
        </button>

    </nav>


    <!-- CONSOLE VIEW -->

    <div
        id="contest-view-console"
        class="contest-view"
    >

        <!-- TWO COLUMN CONTEST LAYOUT -->

        <div class="contest-layout">


        <!-- =====================================
             LEFT: CONTEST CONSOLE
             ===================================== -->

        <div class="contest-main">


            <!-- CONTEST SELECTION -->


            <div
                id="contest-selection"
                class="contest-card"
            >

                <div class="contest-card-header">

                    <div class="contest-card-title">
                        Contest
                    </div>

                </div>


                <div class="contest-selection-row">

                    <label
                        for="contest-select">
                        Contest
                    </label>


                    <select
                        id="contest-select"
                        class="contest-select"
                    >

                        <option value="">
                            Loading contests...
                        </option>

                    </select>


                    <button
                        id="contest-create-button"
                        class="button primary contest-create-button"
                        type="button"
                    >
                        Create Session
                    </button>

                    <div
                        id="contest-session-message"
                        class="contest-session-message"
                    ></div>


                </div>

                <div class="contest-operator-selection">

                    <div class="contest-operator-selection-title">
                        Operators
                    </div>

                    <div
                        id="contest-create-operator-list"
                        class="contest-create-operator-list"
                    >
                        Loading operators...
                    </div>

                </div>

</div>
<!-- =================================

          CONTEST SESSION
                 ================================= -->

            <div
                id="contest-session"
                class="contest-card"
            >

                <div class="contest-card-header">

                    <div class="contest-card-title">
                        Contest Session
                    </div>


                    <div
                        id="contest-status"
                        class="contest-status"
                    >
                        READY
                    </div>

                </div>


                <div class="contest-station-grid">


                    <div class="contest-info">

                        <span>
                            Operator
                        </span>

                        <input
                            id="contest-operator"
                            class="contest-session-input"
                            type="text"
                            autocomplete="off"
                            placeholder="Operator"
                        >

                    </div>


                    <div class="contest-info">

                        <span>
                            Callsign
                        </span>

                        <input
                            id="contest-callsign"
                            class="contest-session-input"
                            type="text"
                            autocomplete="off"
                            placeholder="Callsign"
                        >

                    </div>


                    <div class="contest-info">

                        <span>
                            Club
                        </span>

                        <input
                            id="contest-club"
                            class="contest-session-input"
                            type="text"
                            autocomplete="off"
                            placeholder="Club"
                        >

                    </div>


                    <div class="contest-info">

                        <span>
                            Grid
                        </span>

                        <input
                            id="contest-grid"
                            class="contest-session-input"
                            type="text"
                            autocomplete="off"
                            placeholder="Grid"
                        >

                    </div>


                    <div class="contest-info">

                        <span>
                            Started
                        </span>

                        <strong id="contest-started">
                            —
                        </strong>

                    </div>


                </div>


                <div class="contest-session-actions">

                    <button
                        id="contest-start-button"
                        class="button primary"
                        type="button"
                    >
                        Start Contest
                    </button>


                    <button
                        id="contest-pause-button"
                        class="button secondary"
                        type="button"
                    >
                        Pause
                    </button>


                    <button
                        id="contest-resume-button"
                        class="button secondary"
                        type="button"
                    >
                        Resume
                    </button>


                    <button
                        id="contest-finish-button"
                        class="button secondary"
                        type="button"
                    >
                        Finish
                    </button>

                </div>

            </div>


            <!-- =================================
                 CONTEST OPERATING AREA
                 ================================= -->

            <div
                id="contest-operating-area"
                class="contest-card contest-operating-area"
            >

                <div class="contest-card-header">

                    <div class="contest-card-title">
                        Contest
                    </div>

                </div>


<!-- QSOs BY BAND -->

<div class="contest-qso-by-band">

    <div class="contest-qso-by-band-title">
        QSOs BY BAND
    </div>

    <div class="contest-qso-by-band-table">

        <div class="contest-qso-by-band-row contest-qso-by-band-header">
            <span></span>
            <span>160</span>
            <span>80</span>
            <span>40</span>
            <span>20</span>
            <span>15</span>
            <span>10</span>
            <span>TOTAL</span>
        </div>


        <div class="contest-qso-by-band-row">

            <span>QSOs</span>

            <span id="contest-band-qso-160">0</span>
            <span id="contest-band-qso-80">0</span>
            <span id="contest-band-qso-40">0</span>
            <span id="contest-band-qso-20">0</span>
            <span id="contest-band-qso-15">0</span>
            <span id="contest-band-qso-10">0</span>

            <strong id="contest-band-qso-total">0</strong>

        </div>


        <div class="contest-qso-by-band-row">

            <span>PTS</span>

            <span id="contest-band-points-160">0</span>
            <span id="contest-band-points-80">0</span>
            <span id="contest-band-points-40">0</span>
            <span id="contest-band-points-20">0</span>
            <span id="contest-band-points-15">0</span>
            <span id="contest-band-points-10">0</span>

            <strong id="contest-band-points-total">0</strong>

        </div>

    </div>

</div>


                <!-- CONTEST STATISTICS -->

                <div class="contest-stat-grid">


                    <div class="contest-stat">

                        <span>
                            Band
                        </span>

                        <strong id="contest-band">
                            —
                        </strong>

                    </div>


                    <div class="contest-stat">

                        <span>
                            Mode
                        </span>

                        <strong id="contest-mode">
                            —
                        </strong>

                    </div>


                    <div class="contest-stat">

                        <span>
                            Frequency
                        </span>

                        <strong id="contest-frequency">
                            —
                        </strong>

                    </div>










                </div>


                <!-- QSO ENTRY -->

<div class="contest-qso-entry">

    <div class="contest-entry-field">
        <label for="contest-call">
            Callsign
        </label>

        <input
            id="contest-call"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            placeholder="CALLSIGN"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-name">
            Name
        </label>

        <input
            id="contest-name"
            type="text"
            autocomplete="off"
            spellcheck="false"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-locator">
            Locator
        </label>

        <input
            id="contest-locator"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-rst-sent">
            RST Sent
        </label>

        <input
            id="contest-rst-sent"
            type="text"
            value="599"
            maxlength="3"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-rst-received">
            RST Received
        </label>

        <input
            id="contest-rst-received"
            type="text"
            value="599"
            maxlength="3"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-exchange-sent">
            Exchange Sent
        </label>

        <input
            id="contest-exchange-sent"
            type="text"
            autocomplete="off"
        >
    </div>


    <div class="contest-entry-field">
        <label for="contest-exchange-received">
            Exchange Received
        </label>

        <input
            id="contest-exchange-received"
            type="text"
            autocomplete="off"
        >
    </div>


    <div
        id="contest-canton-field"
        class="contest-entry-field"
        hidden
    >
        <label for="contest-canton">
            Canton
        </label>

        <select
            id="contest-canton"
            autocomplete="off"
        >
            <option value="">
                Select Canton...
            </option>

            <option value="AG">AG</option>
            <option value="AI">AI</option>
            <option value="AR">AR</option>
            <option value="BE">BE</option>
            <option value="BL">BL</option>
            <option value="BS">BS</option>
            <option value="FR">FR</option>
            <option value="GE">GE</option>
            <option value="GL">GL</option>
            <option value="GR">GR</option>
            <option value="JU">JU</option>
            <option value="LU">LU</option>
            <option value="NE">NE</option>
            <option value="NW">NW</option>
            <option value="OW">OW</option>
            <option value="SG">SG</option>
            <option value="SH">SH</option>
            <option value="SO">SO</option>
            <option value="SZ">SZ</option>
            <option value="TG">TG</option>
            <option value="TI">TI</option>
            <option value="UR">UR</option>
            <option value="VD">VD</option>
            <option value="VS">VS</option>
            <option value="ZG">ZG</option>
            <option value="ZH">ZH</option>
        </select>
    </div>


    <button
        id="contest-log-button"
        class="button primary contest-log-button"
        type="button"
    >
        LOG QSO
    </button>

</div>

                <!-- RECENT QSOs -->

                <div class="contest-recent">


                    <div class="contest-recent-title">
                        Recent QSOs
                    </div>


                    <div class="contest-table-wrapper">

                        <table class="contest-table">

                            <thead>

                                <tr>

                                    <th>UTC</th>
                                    <th>CALL</th>
                                    <th>BAND</th>
                                    <th>MODE</th>
                                    <th>RST</th>
                                    <th>EXCHANGE</th>
                                    <th>POINTS</th>

                                </tr>

                            </thead>


                            <tbody id="contest-qso-body">

                                <tr>

                                    <td
                                        colspan="7"
                                        class="contest-empty"
                                    >
                                        No contest QSOs
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>


            </div>


        </div>


        <!-- =====================================
     RIGHT: LIVE BAND VIEWER
     ===================================== -->

<aside class="contest-right">

    <div class="contest-side-card contest-station-card">

    <div class="contest-station-title">
        STATION
    </div>

    <div
        id="contest-active-radio"
        class="contest-active-radio"
    >
        <span class="contest-radio-placeholder">
            Loading radio...
        </span>
    </div>

</div>

    <div class="contest-band-card">

        <!-- HEADER -->

        <div class="contest-band-header">

            <div class="contest-side-title">
                LIVE BAND
            </div>


            <select
                id="contest-band-select"
                class="contest-band-select"
                aria-label="Band auswählen"
            >

                <option value="160m">160m</option>
                <option value="80m">80m</option>
                <option value="60m">60m</option>
                <option value="40m">40m</option>
                <option value="30m">30m</option>
                <option value="20m" selected>20m</option>
                <option value="17m">17m</option>
                <option value="15m">15m</option>
                <option value="12m">12m</option>
                <option value="10m">10m</option>

            </select>

        </div>


        <!-- BAND VIEWPORT -->

        <div
            id="contest-bandplan"
            class="contest-bandplan"
        >

            <div class="contest-band-scale">

                <!-- FREQUENCY AREA -->

                <div
                    id="contest-frequency-scale"
                    class="contest-frequency-scale"
                >
                </div>
                <!-- LIVE SPOTS -->

                <div
                    id="contest-band-spots"
                    class="contest-band-spots"
                >

                    <!--
                        Spots werden später dynamisch
                        anhand der Frequenz positioniert.
                    -->

                </div>


                <!-- CURRENT RADIO FREQUENCY -->

                <div
                    id="contest-current-frequency"
                    class="contest-current-frequency"
                >

                </div>

            </div>

        </div>


        <!-- LEGEND -->

        <div class="contest-band-legend">

            <span>
                <i class="spot-dot spot-new"></i>
                NEW
            </span>

            <span>
                <i class="spot-dot spot-worked"></i>
                WORKED
            </span>

            <span>
                <i class="spot-dot spot-multiplier"></i>
                MULTIPLIER
            </span>

        </div>

    </div>

</aside>

        </div>

    </div>


    <!-- QSOs VIEW -->

    <div
        id="contest-view-qsos"
        class="contest-view"
        hidden
    >

        <div class="contest-qso-list">

            <div class="contest-qso-list-header">

                <div>
                    <h2>Contest QSOs</h2>
                    <span id="contest-qso-count">0 QSOs</span>
                </div>

            </div>

            <div class="contest-table-wrapper">

                <table class="contest-table">

                    <thead>
                        <tr>
                            <th>UTC</th>
                            <th>CALL</th>
                            <th>BAND</th>
                            <th>MODE</th>
                            <th>RST S/R</th>
                            <th>EXCHANGE</th>
                            <th>OPERATOR</th>
                            <th>STATION</th>
                        </tr>
                    </thead>

                    <tbody id="contest-qso-list-body">

                        <tr>
                            <td colspan="8" class="contest-empty">
                                No contest QSOs
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- SESSIONS VIEW -->

    <div
        id="contest-view-sessions"
        class="contest-view"
        hidden
    >

	<div class="contest-session-list">

    <div class="contest-session-list-header">

        <div>
            <h2>Contest Sessions</h2>

            <div class="contest-session-filter">

                <label for="contest-session-contest">
                    Contest
                </label>

                <select
                    id="contest-session-contest"
                    class="contest-session-select"
                >
                    <option value="">All Contests</option>
                </select>

            </div>

            <span id="contest-session-count">0 Sessions</span>
        </div>

    </div>

    <div class="contest-table-wrapper">

        <table class="contest-table">

            <thead>
                <tr>
                    <th>STATUS</th>
                    <th>CONTEST</th>
                    <th>CALLSIGN</th>
                    <th>CLUB</th>
                    <th>GRID</th>
                    <th>OPERATOR</th>
                    <th>OPERATORS</th>
                    <th>STARTED</th>
                    <th>ENDED</th>
                    <th>ACTION</th>
                </tr>
            </thead>

            <tbody id="contest-session-list-body">

                <tr>
                    <td colspan="8" class="contest-empty">
                        No contest sessions
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>
    </div>



    <div
        id="contest-session-operator-editor"
        class="contest-session-operator-editor"
        hidden>

        <div class="contest-session-operator-editor-header">

            <div>
                <h3>Session Operators</h3>

                <span
                    id="contest-session-operator-editor-session">
                </span>
            </div>

            <button
                type="button"
                id="contest-session-operator-editor-close"
                class="button small">
                Close
            </button>

        </div>

        <div
            id="contest-session-operator-list"
            class="contest-session-operator-list">
        </div>

        <div class="contest-session-operator-editor-actions">

            <button
                type="button"
                id="contest-session-operator-save"
                class="button primary">
                Save Operators
            </button>

            <span
                id="contest-session-operator-message"
                class="contest-session-message">
            </span>

        </div>

    </div>

<script src="js/contest-navigation.js"></script>
<script src="js/contest-qsos.js"></script>
<script src="js/contest-sessions.js?v=3"></script>
<script src="js/contest-session.js"></script>
<script src="js/component-loader.js"></script>
<script src="js/station.js"></script>
<script src="js/system-status.js"></script>
<script src="js/contest-band.js?v=2"></script>
</body>

</html>

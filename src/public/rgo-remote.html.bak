<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>RGO ONE Remote</title>

    <link
        rel="stylesheet"
        href="/css/rgo-remote.css"
    >
</head>

<body>

<div class="rgo-shell">

    <!-- HEADER -->
    <header class="rgo-header">

        <div class="rgo-brand">
            <div class="rgo-brand-main">RGO ONE</div>
            <div class="rgo-brand-sub">REMOTE CONTROL</div>
        </div>

        <div class="rgo-header-status">
            <span class="status-dot"></span>
            <span>CONNECTED</span>
        </div>

    </header>


    <!-- MAIN DISPLAY -->
    <main class="rgo-main">

        <!-- LEFT: METER -->
        <section class="rgo-panel meter-panel">

            <div class="panel-title">METER</div>

            <div class="s-meter">

                <div class="s-meter-scale">
                    <span>S1</span>
                    <span>S3</span>
                    <span>S5</span>
                    <span>S7</span>
                    <span>S9</span>
                    <span>+20</span>
                    <span>+40</span>
                </div>

                <div class="s-meter-bar">
                    <div
                        class="s-meter-fill"
                        style="width: 63%;"
                    ></div>
                </div>

                <div class="s-meter-value">
                    S9 +10
                </div>

            </div>

            <div class="meter-select">
                <button class="meter-button active">S</button>
                <button class="meter-button">PWR</button>
                <button class="meter-button">ALC</button>
                <button class="meter-button">SWR</button>
                <button class="meter-button">COMP</button>
            </div>

        </section>


        <!-- CENTER: FREQUENCY -->
        <section class="rgo-panel frequency-panel">

            <div class="frequency-label">
                VFO A
            </div>

            <div class="frequency-display">
                14.175.320
            </div>

            <div class="frequency-unit">
                MHz
            </div>

            <div class="frequency-info">
                <span>USB</span>
                <span>20 m</span>
                <span>AGC</span>
            </div>

            <div class="frequency-scale">
                <span>14.100</span>
                <span>14.150</span>
                <span class="scale-center">14.175</span>
                <span>14.200</span>
                <span>14.250</span>
            </div>

        </section>


        <!-- RIGHT: VFO -->
        <section class="rgo-panel vfo-panel">

            <div class="panel-title">VFO</div>

            <div class="vfo-knob-area">

                <div class="vfo-knob">
                    <div class="vfo-knob-inner"></div>
                    <div class="vfo-knob-marker"></div>
                </div>

            </div>

            <div class="vfo-step">
                STEP
                <strong>1 kHz</strong>
            </div>

        </section>


        <!-- VFO / SPLIT -->
        <section class="rgo-panel vfo-select-panel">

            <div class="panel-title">VFO SELECT</div>

            <div class="button-row">
                <button class="rgo-button active">VFO A</button>
                <button class="rgo-button">VFO B</button>
                <button class="rgo-button">SPLIT</button>
            </div>

        </section>


        <!-- MODE -->
        <section class="rgo-panel mode-panel">

            <div class="panel-title">MODE</div>

            <div class="mode-grid">
                <button class="rgo-button active">USB</button>
                <button class="rgo-button">LSB</button>
                <button class="rgo-button">CW</button>
                <button class="rgo-button">CW-R</button>
                <button class="rgo-button">AM</button>
                <button class="rgo-button">FM</button>
                <button class="rgo-button">DIG</button>
            </div>

        </section>


        <!-- BAND -->
        <section class="rgo-panel band-panel">

            <div class="panel-title">BAND</div>

            <div class="band-grid">
                <button class="rgo-button">160</button>
                <button class="rgo-button">80</button>
                <button class="rgo-button">60</button>
                <button class="rgo-button">40</button>
                <button class="rgo-button">30</button>
                <button class="rgo-button active">20</button>
                <button class="rgo-button">17</button>
                <button class="rgo-button">15</button>
                <button class="rgo-button">12</button>
                <button class="rgo-button">10</button>
            </div>

        </section>


        <!-- FUNCTIONS -->
        <section class="rgo-panel functions-panel">

            <div class="panel-title">FUNCTIONS</div>

            <div class="function-grid">

                <button class="rgo-button active">
                    PREAMP
                </button>

                <button class="rgo-button">
                    ATT
                </button>

                <button class="rgo-button">
                    NB
                </button>

                <button class="rgo-button active">
                    AGC
                </button>

                <button class="rgo-button">
                    ATU
                </button>

            </div>

        </section>


        <!-- GAIN / POWER -->
        <section class="rgo-panel controls-panel">

            <div class="panel-title">LEVELS</div>

            <div class="slider-row">
                <label>RF GAIN</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="82"
                >

                <span>82</span>
            </div>

            <div class="slider-row">
                <label>MIC GAIN</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="58"
                >

                <span>58</span>
            </div>

            <div class="slider-row">
                <label>POWER</label>

                <input
                    type="range"
                    min="0"
                    max="100"
                    value="75"
                >

                <span>75 W</span>
            </div>

        </section>


        <!-- CW -->
        <section class="rgo-panel cw-panel">

            <div class="panel-title">CW</div>

            <div class="slider-row">
                <label>SPEED</label>

                <input
                    type="range"
                    min="4"
                    max="60"
                    value="24"
                >

                <span>24 WPM</span>
            </div>

            <div class="button-row">
                <button class="rgo-button active">
                    BK-IN
                </button>
            </div>

        </section>


        <!-- RIT / XIT -->
        <section class="rgo-panel rit-xit-panel">

            <div class="panel-title">RIT / XIT</div>

            <div class="slider-row">
                <label>RIT</label>

                <input
                    type="range"
                    min="-999"
                    max="999"
                    value="0"
                >

                <span>0</span>
            </div>

            <div class="slider-row">
                <label>XIT</label>

                <input
                    type="range"
                    min="-999"
                    max="999"
                    value="0"
                >

                <span>0</span>
            </div>

        </section>


        <!-- QUICK ACTIONS -->
        <section class="rgo-panel quick-panel">

            <div class="panel-title">QUICK ACTIONS</div>

            <div class="quick-grid">

                <button class="quick-button">
                    A &gt; B
                </button>

                <button class="quick-button">
                    B &gt; A
                </button>

                <button class="quick-button">
                    A = B
                </button>

            </div>

        </section>

    </main>

</div>

</body>
</html>

:root {
    --bg: #101214;
    --panel: #171a1d;
    --panel-dark: #111315;
    --border: #30353a;

    --orange: #ff7a18;
    --orange-bright: #ff9a3d;
    --orange-soft: rgba(255, 122, 24, 0.25);

    --text: #e7e9eb;
    --muted: #7d858c;
    --green: #65d48b;
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family:
        Arial,
        Helvetica,
        sans-serif;
}

body {
    min-height: 100vh;
}


/* =========================================================
   SHELL
   ========================================================= */

.rgo-shell {
    width: 100%;
    min-height: 100vh;
    padding: 12px;

    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(255, 122, 24, 0.08),
            transparent 40%
        ),
        #101214;
}


/* =========================================================
   HEADER
   ========================================================= */

.rgo-header {
    height: 64px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 20px;

    background: #151719;
    border: 1px solid var(--border);
    border-radius: 8px;

    box-shadow:
        0 4px 18px rgba(0, 0, 0, 0.45);
}

.rgo-brand-main {
    color: var(--orange-bright);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 3px;

    text-shadow:
        0 0 8px rgba(255, 122, 24, 0.35);
}

.rgo-brand-sub {
    margin-top: 2px;

    color: var(--muted);
    font-size: 10px;
    letter-spacing: 3px;
}

.rgo-header-status {
    display: flex;
    align-items: center;
    gap: 9px;

    color: var(--green);
    font-size: 11px;
    letter-spacing: 1px;
}

.status-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;
    background: var(--green);

    box-shadow:
        0 0 6px var(--green),
        0 0 12px rgba(101, 212, 139, 0.5);
}


/* =========================================================
   MAIN GRID
   ========================================================= */

.rgo-main {
    margin-top: 12px;

    display: grid;

    grid-template-columns:
        220px
        minmax(420px, 1fr)
        220px;

    grid-template-areas:

        "meter frequency vfo"

        "vfo-select mode band"

        "functions controls cw"

        "rit quick quick";

    gap: 10px;
}


/* =========================================================
   PANELS
   ========================================================= */

.rgo-panel {
    position: relative;

    padding: 14px;

    background:
        linear-gradient(
            145deg,
            #1a1d20,
            #141618
        );

    border: 1px solid var(--border);
    border-radius: 8px;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.025),
        0 4px 16px rgba(0,0,0,0.35);
}

.panel-title {
    margin-bottom: 12px;

    color: var(--muted);

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}


/* =========================================================
   GRID AREAS
   ========================================================= */

.meter-panel {
    grid-area: meter;
}

.frequency-panel {
    grid-area: frequency;
}

.vfo-panel {
    grid-area: vfo;
}

.vfo-select-panel {
    grid-area: vfo-select;
}

.mode-panel {
    grid-area: mode;
}

.band-panel {
    grid-area: band;
}

.functions-panel {
    grid-area: functions;
}

.controls-panel {
    grid-area: controls;
}

.cw-panel {
    grid-area: cw;
}

.rit-xit-panel {
    grid-area: rit;
}

.quick-panel {
    grid-area: quick;
}


/* =========================================================
   FREQUENCY
   ========================================================= */

.frequency-panel {
    min-height: 235px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    overflow: hidden;
}

.frequency-label {
    color: var(--muted);

    font-size: 11px;
    letter-spacing: 3px;
}

.frequency-display {
    margin-top: 4px;

    color: var(--orange-bright);

    font-family:
        "Courier New",
        monospace;

    font-size: clamp(42px, 6vw, 78px);
    font-weight: 700;

    letter-spacing: 4px;

    text-shadow:
        0 0 5px rgba(255,122,24,0.55),
        0 0 18px rgba(255,122,24,0.28);
}

.frequency-unit {
    margin-top: -4px;

    color: var(--muted);

    font-size: 12px;
    letter-spacing: 3px;
}

.frequency-info {
    display: flex;
    gap: 25px;

    margin-top: 18px;

    color: #b9c0c5;

    font-size: 11px;
    letter-spacing: 1px;
}

.frequency-info span:first-child {
    color: var(--orange-bright);
}

.frequency-scale {
    position: absolute;
    bottom: 12px;
    left: 18px;
    right: 18px;

    display: flex;
    justify-content: space-between;

    color: #626a71;

    font-family: monospace;
    font-size: 9px;
}

.scale-center {
    color: var(--orange);
}


/* =========================================================
   S METER
   ========================================================= */

.meter-panel {
    min-height: 235px;
}

.s-meter {
    margin-top: 30px;
}

.s-meter-scale {
    display: flex;
    justify-content: space-between;

    color: #687178;

    font-family: monospace;
    font-size: 8px;
}

.s-meter-bar {
    height: 18px;

    margin-top: 8px;

    padding: 2px;

    background: #090b0c;
    border: 1px solid #343a3f;
}

.s-meter-fill {
    height: 100%;

    background:
        linear-gradient(
            90deg,
            #7e9b45 0%,
            #c6a93c 55%,
            #e66d29 80%,
            #d83b30 100%
        );

    box-shadow:
        0 0 8px rgba(255,122,24,0.25);
}

.s-meter-value {
    margin-top: 12px;

    color: var(--orange-bright);

    font-family: monospace;
    font-size: 20px;
    text-align: center;
}

.meter-select {
    display: grid;
    grid-template-columns: repeat(5, 1fr);

    gap: 4px;

    margin-top: 24px;
}


/* =========================================================
   VFO KNOB
   ========================================================= */

.vfo-panel {
    min-height: 235px;

    text-align: center;
}

.vfo-knob-area {
    display: flex;
    justify-content: center;
    align-items: center;

    height: 155px;
}

.vfo-knob {
    position: relative;

    width: 135px;
    height: 135px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 35% 30%,
            #3c4145,
            #1d2023 48%,
            #0d0f10 75%
        );

    border: 2px solid #444b50;

    box-shadow:
        inset 0 4px 8px rgba(255,255,255,0.08),
        inset 0 -8px 15px rgba(0,0,0,0.8),
        0 0 0 5px #101214,
        0 0 18px rgba(0,0,0,0.7);
}

.vfo-knob-inner {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 86px;
    height: 86px;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    border: 1px solid #30363b;
}

.vfo-knob-marker {
    position: absolute;

    top: 12px;
    left: 50%;

    width: 3px;
    height: 24px;

    transform: translateX(-50%);

    background: var(--orange);

    box-shadow:
        0 0 8px var(--orange);
}

.vfo-step {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.vfo-step strong {
    color: var(--orange-bright);
    margin-left: 6px;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.button-row {
    display: flex;
    gap: 6px;
}

.rgo-button,
.quick-button,
.meter-button {
    border: 1px solid #394046;

    background:
        linear-gradient(
            180deg,
            #22272b,
            #171a1d
        );

    color: #b9c0c5;

    border-radius: 5px;

    min-height: 32px;

    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.7px;

    cursor: pointer;

    transition:
        border-color 0.15s,
        color 0.15s,
        box-shadow 0.15s,
        background 0.15s;
}

.rgo-button:hover,
.quick-button:hover,
.meter-button:hover {
    border-color: #7a4b27;
    color: #e4e7e9;
}

.rgo-button.active,
.meter-button.active {
    color: var(--orange-bright);

    border-color: var(--orange);

    background:
        linear-gradient(
            180deg,
            #302019,
            #1b1715
        );

    box-shadow:
        inset 0 0 12px rgba(255,122,24,0.08),
        0 0 7px rgba(255,122,24,0.15);
}

.vfo-select-panel .button-row .rgo-button {
    flex: 1;
}


/* =========================================================
   MODE / BAND / FUNCTIONS
   ========================================================= */

.mode-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
}

.band-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
}

.function-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
}

.function-grid .rgo-button:last-child {
    grid-column: span 2;
}


/* =========================================================
   SLIDERS
   ========================================================= */

.slider-row {
    display: grid;

    grid-template-columns:
        68px
        1fr
        55px;

    align-items: center;

    gap: 10px;

    margin-bottom: 13px;
}

.slider-row:last-child {
    margin-bottom: 0;
}

.slider-row label {
    color: #9da5ab;

    font-size: 9px;
    letter-spacing: 1px;
}

.slider-row span {
    color: var(--orange-bright);

    font-family: monospace;
    font-size: 11px;

    text-align: right;
}

.slider-row input[type="range"] {
    width: 100%;

    accent-color: var(--orange);
}


/* =========================================================
   CW
   ========================================================= */

.cw-panel .button-row {
    margin-top: 14px;
}

.cw-panel .rgo-button {
    width: 100%;
}


/* =========================================================
   RIT / XIT
   ========================================================= */

.rit-xit-panel .slider-row {
    grid-template-columns:
        38px
        1fr
        42px;

    margin-bottom: 17px;
}

.rit-xit-panel {
    min-height: 120px;
}


/* =========================================================
   QUICK ACTIONS
   ========================================================= */

.quick-panel {
    min-height: 120px;
}

.quick-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 8px;
}

.quick-button {
    min-height: 48px;

    color: #c5cbd0;

    font-size: 11px;
}

.quick-button:first-child {
    color: var(--orange-bright);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .rgo-main {
        grid-template-columns:
            1fr
            1fr;

        grid-template-areas:

            "frequency frequency"

            "meter vfo"

            "vfo-select mode"

            "band band"

            "functions controls"

            "cw rit"

            "quick quick";
    }

}


@media (max-width: 650px) {

    .rgo-shell {
        padding: 6px;
    }

    .rgo-header {
        height: 54px;
        padding: 0 12px;
    }

    .rgo-brand-main {
        font-size: 18px;
    }

    .rgo-brand-sub {
        font-size: 8px;
    }

    .rgo-main {
        grid-template-columns: 1fr;

        grid-template-areas:

            "frequency"
            "meter"
            "vfo"
            "vfo-select"
            "mode"
            "band"
            "functions"
            "controls"
            "cw"
            "rit"
            "quick";
    }

    .frequency-display {
        font-size: 38px;
        letter-spacing: 2px;
    }

}

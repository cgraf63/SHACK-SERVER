//* =========================================
   SHACK-SERVER COMPONENTS
   Dashboard v1.0
========================================= */


/* ---------- General Cards ---------- */

.card {

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 16px;

    box-sizing: border-box;

}


.card h2 {

    color: var(--cyan);

    font-size: 16px;

    margin: 0 0 14px 0;

    font-weight: 600;

}



/* =========================================
   HEADER
========================================= */

.header {

    display:flex;

    justify-content:space-between;

    align-items:center;

}


.header-title {

    color:var(--cyan);

    font-size:28px;

    font-weight:700;

}



/* =========================================
   COMMAND STRIP
========================================= */

.command-card {

    min-height:55px;

}



/* =========================================
   PROPAGATION & STATION
========================================= */

.propagation-bar {

    height:100px;

    min-height:90px;

    padding:12px 20px;

    overflow:hidden;

}


.propagation-bar h2 {

    font-size:13px;

    margin:0 0 5px 0;

}



.propagation-content {

    display:flex;

    align-items:flex-start;

    gap:25px;

}



.solar-data {

    display:flex;

    align-items:center;

    gap:15px;

    white-space:nowrap;

}



.sun-icon {

    font-size:22px;
    color: #ffd54a;

}



.solar-data strong {

    display:block;

    color:var(--cyan);

    font-size:18px;

}

.station-inline {
    white-space: nowrap;
    border-left: 1px solid var(--panel-border);
    padding-left: 20px;
    align-self: flex-start;
    margin-top: -25px;
}

.station-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
    margin-bottom: 5px;
}

#station-inline-content {

    display: flex;

    align-items: stretch;

    gap: 6px;

    font-size: 13px;

}


.station-inline-radio {

    flex: 0 0 230px;

    min-width: 230px;

    padding: 6px 8px;

    border: 1px solid
        rgba(255,255,255,0.08);

    border-radius: 6px;

    cursor: pointer;

    transition:
        border-color 0.15s,
        background 0.15s;

}


.station-inline-radio:hover {

    border-color: cyan;

}


.station-inline-radio.active {

    border: 2px solid cyan;

    background:
        rgba(0,255,255,0.06);

}


.station-inline-radio.disconnected {

    opacity: 0.55;

}


.station-inline-name {

    font-size: 11px;

    color:
        var(--text-muted);

    margin-bottom: 2px;

    text-transform: uppercase;

}


.station-inline-data {

    font-size: 13px;

    color:
        var(--text);

    white-space: nowrap;

}


.station-inline-cat {

    display: inline-flex;

    align-items: center;

    gap: 3px;

    margin-top: 0;

    font-size: 10px;

    color:
        var(--text);

}

#station-inline-content strong {
    font-size: 15px;
    color: var(--text);
}

.station-radio-data {
    color: var(--text);
}

.cat-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text);
}

.cat-dot {

    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #e05252;

    display: inline-block;

}


.cat-dot.connected {

    background: #00ff3c;

}


.cat-dot.disconnected {

    background: #e05252;

}



  
.band-section {

    width:600px;

    flex:none;

}

.band-labels {

    display:flex;

    justify-content:space-between;

    width:600px;

}



.band-line {

    height:35px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    width:600px;

}
.band-point {

    width:10px;

    height:10px;

    border-radius:50%;

    display:block;

}


.band-point.excellent {

    background:#7fff00;

}


.band-point.good {

    background:#00ffff;

}


.band-point.fair {

    background:#ffd000;

}


.band-point.poor {

    background:#ff4040;

}



.condition-labels {

    display:flex;

    justify-content:space-between;

    font-size:11px;

}


.condition-labels span:first-child {

    color:#ff4040;

}


.condition-labels span:last-child {

    color:#7fff00;

}



/* =========================================
   CLUSTER CONNECTIONS
========================================= */


.cluster-list {

    display:flex;

    flex-direction:column;

    gap:8px;

}



.dx-flag {
    width: 24px;
    height: 18px;
    vertical-align: middle;
    margin-right: 8px;
}


.cluster-item {

    display:flex;

    align-items:center;

    justify-content:flex-start;

    font-size:14px;

}



.status-online {

    width:8px;

    height:8px;

    border-radius:50%;

    background:#7fff00;

    margin-right:8px;

}



/* =========================================
   LIVE SPOTS
========================================= */


.live-card {

    width:100%;

}

/* =========================================
   LIVE SPOT FILTERS
========================================= */

.spot-filters {

    display:flex;

    align-items:center;

    gap:18px;

    flex-wrap:nowrap;
}



.spot-filters input,
.spot-filters select {

    background:var(--panel);

    border:1px solid var(--border);

    color:#cccccc;

    border-radius:6px;

    height:32px;

    padding:0 10px;

    font-size:13px;

}



.spot-filters input {

    flex:1;

    width:100px;

}



.spot-filters select {

    min-width:130px;

}



.spot-filters input::placeholder {

    color:#888;

}




/////////////////////////////////////////////////////////
/ Spot-Actions 
/////////////////////////////////////////////////////////


.spot-actions {

    display:flex;

    gap:8px;

    align-items:center;

}


.spot-btn {

    background:transparent;

    border:none;

    padding:0;

    cursor:pointer;

    font-size:16px;

    opacity:0.75;

    transition:0.2s;

}


.spot-btn:hover {

    opacity:1;

    transform:scale(1.25);

}


.worked-help-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 16px;
    height: 16px;

    margin-right: 6px;

    border: 1px solid #777;
    border-radius: 50%;

    background: transparent;
    color: #ccc;

    font-size: 11px;
    font-weight: bold;

    cursor: pointer;
    vertical-align: middle;
}

.worked-help-btn:hover {
    color: white;
    border-color: white;
}



.worked-indicator {
    display: inline-block;
    font-size: 30px;
    position: relative;
    top: 3px;
    margin-right: 7px;
}

/* Station auf diesem Band bereits gearbeitet */
.worked-station-band {
    color: #00c853;
}

/* Land auf diesem Band bereits gearbeitet */
.worked-country-band {
    color: #ffd54f;
}

/* Station bereits gearbeitet, anderes Band */
.worked-station {
    color: #174ee6;
}

/* Land bereits gearbeitet, anderes Band */
.worked-country {
    color: #9c6ade;
}

/* Weder Station noch Land gearbeitet */
.worked-new {
    color: #e8e8e8;
}



#worked-help-popup {
    position: fixed;
    z-index: 9999;

    padding: 10px 14px;

    background: var(--card-bg, #1e1e1e);
    border: 1px solid var(--border, #555);
    border-radius: 6px;

    box-shadow: 0 4px 14px rgba(0,0,0,0.35);

    font-size: 12px;
    white-space: nowrap;
}

.worked-help-row {
    display: flex;
    align-items: center;
    gap: 8px;

    height: 22px;
}

.worked-help-dot {
    font-size: 20px;
    line-height: 1;
}

.worked-help-green  { color: #00c853; }
.worked-help-yellow { color: #ffd54f; }
.worked-help-blue   { color: #174ea6; }
.worked-help-purple { color: #9c6ade; }
.worked-help-new    { color: #e8e8e8; }



.card-header {

    display:flex;

    justify-content:space-between;

    align-items:center;

}



.view-link {

    color:var(--cyan);

    font-size:13px;

}



.live-table {

    width:100%;
    border-collapse:collapse;
 /*   table-layout: fixed; */
}



.live-table th {

    text-align:left;

    color:#ffc400;

    font-size:12px;

    padding:8px;

}



.live-table td {

    padding:4px 8px;

    border-bottom:1px solid var(--border);

    font-size:14px;

    line-height:1.1;

    border-collapse:collapse;
}


.live-table .frequency {

    color:var(--cyan);

}

.live-table .comment-cell {
    width: 240px;
    max-width: 240px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #cccccc;
}



.live-table .source {

    color:var(--cyan);

}


        .dxspider-row {
            display: grid;
            grid-template-columns:
                30px
                1fr
                1.5fr
                100px
                1fr
                50px;

            gap: 10px;
            align-items: center;
            margin: 12px 0;
        }


        .dxspider-row input[type="text"],
        .dxspider-row input[type="number"],
        .dxspider-row input[type="password"] {
            width: 100%;
            box-sizing: border-box;
            padding: 9px 10px;
        }


        .dxspider-delete {
            padding: 8px;
            cursor: pointer;
        }




.live-table .confidence {

    color:#9cff00;

}


.reset-button {

    background: transparent;

    border: 1px solid var(--border);

    color: var(--text);

    padding: 5px 12px;

    border-radius: 6px;

    cursor: pointer;

    font-size: 13px;

}


.reset-button:hover {

    color: cyan;

    border-color: cyan;

}



/* =========================================
   STATION STATUS
========================================= */


.station-status {

    min-height:180px;

}



.station-status p {

    margin:6px 0;

}

.station-radios {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            230px
        );

    gap: 10px;

}


.station-radio-card {

 width: 230px !important;

    min-width: 230px !important;



    min-height: 115px;

    padding: 12px;

    border: 1px solid
        var(--border);

    border-radius: 8px;

    background:
        rgba(255,255,255,0.02);

    cursor: pointer;

    transition:
        border-color 0.15s,
        background 0.15s,
        transform 0.15s;

}


.station-radio-card:hover {

    border-color:
        var(--cyan);

    transform:
        translateY(-1px);

}


.station-radio-card.active {

    border: 2px solid cyan !important;
       

    background:
        rgba(0,255,255,0.10);

}


.station-radio-card.disconnected {

    opacity: 0.65;

}


.station-radio-name {

    color:
        var(--cyan);

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 10px;

}


.station-radio-frequency {

    font-size: 20px;

    font-weight: 700;

    color:
        #ffffff;

    margin-bottom: 6px;

}


.station-radio-details {

    font-size: 13px;

    color:
        #cccccc;

    margin-bottom: 8px;

}


.station-radio-connection {

    font-size: 12px;

    color:
        #999999;

}


.station-radio-card.active .station-radio-connection {

    color:
        var(--cyan);

}


.station-radio-placeholder {

    color:
        #999999;

    padding: 20px;

}

/* =========================================
   PRIORITY DX
========================================= */


.priority-list {

    display:flex;

    flex-direction:column;

    gap:8px;

}



/* =========================================
   RECOMMENDATIONS
========================================= */


.recommendation-item {

    padding:8px 0;

    border-bottom:1px solid var(--border);

}



/* =========================================
   SOURCES
========================================= */


.source-item {

    padding:8px 0;

    border-bottom:1px solid var(--border);

}

/* =========================================
   SOURCE HEALTH / DIAGNOSTICS
========================================= */

.source-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 9px 0;

    border-bottom: 1px solid
        var(--border);

}


.source-name {

    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 0;

}


.source-indicator {

    width: 9px;

    height: 9px;

    min-width: 9px;

    border-radius: 50%;

    display: inline-block;

}


.source-indicator.active {

    background: #35d07f;

    box-shadow:
        0 0 7px rgba(53, 208, 127, 0.7);

}


.source-indicator.silent {

    background: #e5a93d;

    box-shadow:
        0 0 7px rgba(229, 169, 61, 0.6);

}


.source-indicator.inactive {

    background: #777777;

}


.source-status {

    display: flex;

    align-items: center;

    gap: 10px;

    white-space: nowrap;

}


.status-active {

    color: #35d07f;

}


.status-silent {

    color: #e5a93d;

}


.status-inactive {

    color: #888888;

}


.source-age {

    color: #888888;

    font-size: 0.85em;

}

/* =========================================
   SMALL SCREENS
========================================= */

@media(max-width:900px) {


    .propagation-content {

        gap:10px;

    }


    .band-section {

        display:none;

    }


}
/* =========================================
   SIDEBAR BRAND / LOGO
========================================= */

.brand {

    text-align: center;

}


.logo {

    width: 120px;

    height: 120px;

    object-fit: contain;

    display: block;

    margin: 0 auto 15px auto;

}


.brand-name {

    text-align: center;

    color: var(--cyan);

    font-size: 18px;

    font-weight: 700;

}
.command-strip {

    margin-top:20px;

}


.command-strip h2 {

    font-size:14px;

    margin-bottom:10px;

}


.command-grid {

    display:grid;

    grid-template-columns:repeat(4,1fr);

}



.command-item {

    display:flex;

    align-items:center;

    gap:15px;

    padding:8px 20px;

    border-right:1px solid var(--border);

}


.command-item:last-child {

    border-right:none;

}


.command-icon {

    font-size:22px;

}


.command-item span {

    display:block;

    font-size:12px;

    color:#cccccc;

}


.command-item strong {

    display:block;

    margin-top:4px;

    color:var(--cyan);

}
.header h1 {

    margin: 0;

    font-size: 32px;

    line-height: 1;

}


/* DX Cluster flags */
img.flag {
    width: 16px;
    height: 12px;
    max-width: 16px;
    max-height: 12px;
    display: inline-block;
    object-fit: cover;
    vertical-align: middle;
    margin-right: 5px;
}


/* =========================================
   SYSTEM STATUS SIDEBAR
========================================= */

.system-status {

    margin-top:15px;

    padding:10px;

    background:#08131b;

    border-radius:8px;

    font-size:12px;

}


.system-status h3 {

    margin:0 0 8px 0;

    font-size:12px;

    color:var(--cyan);

}


.status-line {

    line-height:1.5;

}


/* =========================================
   SIDEBAR NAVIGATION
   ========================================= */

.nav-section {
    margin: 20px 12px 7px;

    color: #b56cff;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
}


.sidebar nav a {
    display: block;

    padding: 9px 12px;
    margin: 2px 0;

    color: var(--text);

    text-decoration: none;

    border-radius: 6px;

    transition:
        background 0.15s ease,
        color 0.15s ease;
}


.sidebar nav a:hover {
    color: #e06cff;

    background:
        rgba(181, 108, 255, 0.10);

    text-decoration: none;
}


.sidebar nav a.active {
    color: #b56cff;

    background:
        rgba(181, 108, 255, 0.14);

    font-weight: 600;

    text-decoration: none;
}


.nav-separator {
    margin: 18px 12px 8px;

    border-top:
        1px solid var(--border);
}


.nav-shutdown {
    color: #ff7070 !important;
}


.nav-shutdown:hover {
    color: #ff9090 !important;

    background:
        rgba(255, 80, 80, 0.08) !important;
}


/* =========================================
   SHUTDOWN DIALOG
   ========================================= */

.shutdown-modal {
    display: none;

    position: fixed;
    inset: 0;

    z-index: 10000;

    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.55);
}

.shutdown-modal.visible {
    display: flex;
}

.shutdown-dialog {
    width: 360px;

    padding: 24px;

    background: #10151c;

    border: 1px solid rgba(181, 108, 255, 0.45);
    border-radius: 10px;

    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.55);
}

.shutdown-title {
    color: #b56cff;

    font-size: 18px;
    font-weight: 600;

    margin-bottom: 12px;
}

.shutdown-message {
    color: var(--text);

    font-size: 14px;
    line-height: 1.5;

    margin-bottom: 22px;
}

.shutdown-actions {
    display: flex;

    justify-content: flex-end;
    gap: 10px;
}

.shutdown-actions button {
    padding: 8px 16px;

    border: 0;
    border-radius: 6px;

    font-size: 13px;
    cursor: pointer;
}

.shutdown-cancel {
    color: var(--text);
    background: #252b34;
}

.shutdown-cancel:hover {
    background: #303743;
}

.shutdown-confirm {
    color: white;
    background: #d95757;
}

.shutdown-confirm:hover {
    background: #ed6868;
}

/* =========================================
   ABOUT PRESENTATION
   ========================================= */

.about-modal {

    position: fixed;

    inset: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    background: rgba(0, 0, 0, 0.82);

    backdrop-filter: blur(8px);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease;

    z-index: 9999;
}


.about-modal.visible {

    opacity: 1;

    visibility: visible;

    pointer-events: auto;

}


.about-dialog {

    position: relative;

    width: min(
        900px,
        90vw
    );

    max-height: 90vh;

    padding: 20px;

    background: #050a12;

    border: 1px solid rgba(
        0,
        200,
        255,
        0.22
    );

    border-radius: 18px;

    box-shadow:
        0 0 40px rgba(
            0,
            180,
            255,
            0.12
        ),
        0 25px 80px rgba(
            0,
            0,
            0,
            0.7
        );

    transform:
        scale(0.94)
        translateY(10px);

    transition:
        transform 0.3s ease;
}


.about-modal.visible
.about-dialog {

    transform:
        scale(1)
        translateY(0);

}


.about-logo-wrapper {

    width: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

}


.about-logo {

    display: block;

    width: 100%;

    max-width: 850px;

    height: auto;

}


/* Close button */

.about-close {

    position: absolute;

    top: 12px;

    right: 14px;

    width: 34px;

    height: 34px;

    border: 0;

    border-radius: 50%;

    background: rgba(
        255,
        255,
        255,
        0.08
    );

    color: #ffffff;

    font-size: 25px;

    line-height: 32px;

    cursor: pointer;

    z-index: 2;

    transition:
        background 0.2s ease,
        transform 0.2s ease;

}


.about-close:hover {

    background: rgba(
        255,
        255,
        255,
        0.16
    );

    transform: scale(1.08);

}
/* =====================================================
   SETTINGS MODAL
   ===================================================== */

.settings-modal {
    position: fixed;
    inset: 0;

    display: none;

    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.65);

    z-index: 10000;
}


.settings-modal.open {
    display: flex;
}


.settings-dialog {
    width: min(900px, 92vw);
    max-height: 90vh;

    display: flex;
    flex-direction: column;

    background: var(--panel-bg, #15191f);

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 10px;

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.55);

    overflow: hidden;
}


.settings-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 18px 22px;

    border-bottom: 1px solid
        var(--border-color, #303640);
}


.settings-title {
    font-size: 20px;
    font-weight: 700;
}


.settings-close {
    width: 36px;
    height: 36px;

    border: none;
    border-radius: 6px;

    background: transparent;

    color: inherit;

    font-size: 28px;
    line-height: 1;

    cursor: pointer;
}


.settings-close:hover {
    background: rgba(255, 255, 255, 0.08);
}


.settings-content {
    padding: 24px;

    overflow-y: auto;
}


.settings-section {
    margin-bottom: 28px;
}


.settings-section h2 {
    margin: 0 0 18px 0;

    font-size: 16px;
}


.settings-grid {
    display: grid;

    grid-template-columns: 160px 1fr;

    gap: 12px 18px;

    align-items: center;
}


.settings-grid label {
    font-weight: 600;
}


.settings-grid input {
    width: 100%;

    box-sizing: border-box;

    padding: 9px 12px;

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 5px;

    background: rgba(255, 255, 255, 0.04);

    color: inherit;
}


/* =====================================================
   SOURCE MASTER SWITCHES
   ===================================================== */

.source-master-row {
    margin: 14px 0;
}


.source-switch {
    display: flex;

    align-items: center;

    gap: 10px;

    font-weight: 600;

    cursor: pointer;
}


.source-switch input {
    width: 18px;
    height: 18px;

    cursor: pointer;
}


/* =====================================================
   DXSPIDER
   ===================================================== */

.dxspider-list {
    display: flex;

    flex-direction: column;

    gap: 12px;

    margin: 14px 0 16px 0;
}


.dxspider-card {
    padding: 16px;

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 8px;

    background: rgba(255, 255, 255, 0.025);
}


.dxspider-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 14px;
}


.dxspider-title {
    font-size: 15px;
    font-weight: 700;
}


.dxspider-enabled {
    display: flex;

    align-items: center;

    gap: 7px;

    font-size: 13px;

    cursor: pointer;
}


.dxspider-grid {
    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 10px 14px;

    align-items: center;
}


.dxspider-grid label {
    font-size: 13px;
    font-weight: 600;
}


.dxspider-grid input {
    width: 100%;

    box-sizing: border-box;

    padding: 8px 10px;

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 5px;

    background: rgba(255, 255, 255, 0.04);

    color: inherit;
}


.dxspider-actions {
    display: flex;

    justify-content: flex-end;

    margin-top: 14px;
}


.remove-dxspider {
    padding: 7px 12px;

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 5px;

    background: transparent;

    color: inherit;

    cursor: pointer;
}


.remove-dxspider:hover {
    background: rgba(255, 80, 80, 0.12);
}


.settings-secondary-button {
    padding: 8px 14px;

    border: 1px solid
        var(--border-color, #303640);

    border-radius: 5px;

    background: transparent;

    color: inherit;

    cursor: pointer;
}


.settings-secondary-button:hover {
    background: rgba(255, 255, 255, 0.08);
}


/* =====================================================
   ACTIONS
   ===================================================== */

.settings-actions {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 24px;

    padding-top: 18px;

    border-top: 1px solid
        var(--border-color, #303640);
}


.settings-save,
.settings-cancel {
    padding: 9px 20px;

    border-radius: 5px;

    cursor: pointer;
}


.settings-save {
    border: 1px solid
        var(--border-color, #303640);

    background: rgba(255, 255, 255, 0.08);

    color: inherit;
}


.settings-cancel {
    border: 1px solid
        var(--border-color, #303640);

    background: transparent;

    color: inherit;
}


.settings-message {
    margin-left: auto;

    min-height: 20px;

    font-size: 13px;
}


/* =====================================================
   MOBILE
   ===================================================== */

@media (max-width: 700px) {

    .settings-dialog {
        width: 96vw;
        max-height: 94vh;
    }


    .settings-content {
        padding: 18px;
    }


    .settings-grid {
        grid-template-columns: 1fr;
    }


    .dxspider-grid {
        grid-template-columns: 1fr;
    }


    .settings-actions {
        flex-wrap: wrap;
    }


    .settings-message {
        width: 100%;
        margin-left: 0;
    }

}

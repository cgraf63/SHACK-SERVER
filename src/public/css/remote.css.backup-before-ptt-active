* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

body {
    background:
        radial-gradient(circle at 50% 0%, #182735 0%, #0a1118 45%, #05090d 100%);
    color: #e7edf5;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    user-select: none;
}


/* ============================================================
   TOP BAR
   ============================================================ */

.topbar {
    height: 58px;
    display: flex;
    align-items: center;
    padding: 0 14px;
    gap: 14px;

    background: linear-gradient(
        180deg,
        #14212c 0%,
        #091017 100%
    );

    border-bottom: 1px solid #30404d;
    box-shadow: 0 3px 15px #00000080;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 300px;
}

.brand-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.brand-icon img {
    width: 36px;
    height: 36px;
    display: block;
}

.brand-name {
    font-size: 23px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #91bce3;
}

.brand-sub {
    font-size: 9px;
    letter-spacing: 3px;
    color: #72889a;
}

.header-separator {
    width: 1px;
    height: 34px;
    background: #3a4a57;
}

.radio-name {
    font-size: 24px;
    font-weight: 700;
    font-style: italic;
    color: #f0d88d;
}

.connection {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #b8c7d4;
    font-size: 12px;
    font-weight: 600;
}

.status-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3ce17a;
    box-shadow: 0 0 10px #3ce17a;
}

.header-spacer {
    flex: 1;
}

.operator {
    line-height: 16px;
    color: #aebdca;
    text-align: right;
}

.clock {
    line-height: 16px;
    color: #8798a7;
    min-width: 130px;
}

.clock strong {
    display: block;
    font-size: 16px;
    color: #dbe4ec;
}

.header-icon,
.power-icon {
    font-size: 23px;
    color: #9cafbf;
    width: 30px;
    text-align: center;
}

.power-icon {
    color: #ff424d;
    font-size: 27px;
}


/* ============================================================
   MAIN CONSOLE
   ============================================================ */

.console {
    height: calc(100vh - 90px);
    padding: 9px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-height: 600px;
}


/* ============================================================
   PANELS
   ============================================================ */

.panel {
    position: relative;

    background:
        linear-gradient(
            145deg,
            #111d27 0%,
            #091118 70%
        );

    border: 1px solid #30414e;
    border-radius: 8px;

    box-shadow:
        inset 0 1px 0 #ffffff0b,
        inset 0 -15px 30px #00000020,
        0 2px 8px #00000070;

    overflow: hidden;
}

.panel::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 7px;
    pointer-events: none;
    border: 1px solid #ffffff05;
}

.panel-title,
.section-title {
    font-size: 18px;
    font-weight: 600;
    font-style: italic;
    letter-spacing: 1px;
    color: #f0df9d;
}


/* ============================================================
   TOP ROW
   ============================================================ */

.top-row {
    height: 190px;

    display: grid;

    grid-template-columns:
        minmax(280px, 1fr)
        360px
        minmax(280px, 1fr)
        390px;

    gap: 7px;
}


/* ============================================================
   VFO
   ============================================================ */

.vfo-panel {
    padding: 7px 13px;
}

.vfo-panel .panel-title {
    position: absolute;
    top: 5px;
    left: 15px;
}

.vfo-status {
    height: 31px;
    margin-top: 27px;

    display: flex;
    align-items: center;
    gap: 6px;
}

.tx-badge,
.small-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 25px;
    padding: 0 10px;

    border-radius: 5px;

    background: #17242e;
    border: 1px solid #293a47;

    color: #d8c98f;
    font-size: 12px;
}

.tx-badge {
    color: #ff5555;
    border: 2px solid #ff2d2d;
    background: #351316;
    font-weight: 700;
}

.small-badge.active {
    background: #d62828;
    color: #ffffff;
}

.vfo-control-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 72px;
    height: 38px;
    padding: 2px 5px;

    border-radius: 5px;

    background: #17242e;
    border: 1px solid #293a47;

    color: #d8c98f;
    font-size: 10px;
    line-height: 12px;

    cursor: pointer;
}

.vfo-control-badge .badge-label {
    font-size: 9px;
    color: #8fa3b2;
}

.vfo-control-badge .badge-value {
    font-size: 12px;
    color: #e0e8ef;
    font-weight: 600;
}

.vfo-control-badge.active {
    background: #d62828;
    color: #ffffff;
}

.vfo-control-badge.active .badge-label,
.vfo-control-badge.active .badge-value {
    color: #ffffff;
}

.vfo-control-badge.display-only {
    cursor: default;
}


.frequency {
    height: 71px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: clamp(40px, 4vw, 62px);
    font-weight: 600;
    letter-spacing: 2px;

    color: #f3f8ff;

    text-shadow:
        0 0 5px #ffffff,
        0 0 15px #5799ff,
        0 0 28px #2d68bc;
}


/* ============================================================
   BUTTONS
   ============================================================ */

button {
    border: 1px solid #344754;
    border-radius: 5px;

    background:
        linear-gradient(
            180deg,
            #1d2b36 0%,
            #101a22 100%
        );

    color: #e0e8ef;
    font-family: inherit;
    font-size: 13px;

    cursor: pointer;

    box-shadow:
        inset 0 1px 0 #ffffff0b,
        0 2px 4px #00000050;
}

button:hover {
    border-color: #557083;
}

button.active {
    border-color: #08aaff;

    background:
        linear-gradient(
            180deg,
            #123c5f 0%,
            #102638 100%
        );

    color: #ffffff;

    box-shadow:
        inset 0 0 12px #008cff55,
        0 0 8px #008cff40;
}

.vfo-controls {
    display: flex;
    gap: 7px;
    align-items: center;
}

.band-button {
    height: 32px;
    min-width: 112px;
}

.big-button {
    height: 32px;
    min-width: 65px;
    font-size: 14px;
}


/* ============================================================
   SPLIT
   ============================================================ */

.split-panel {
    padding: 9px;
}

.split-frequency {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    margin-top: 5px;
    padding: 2px 4px;
}

.split-frequency span {
    color: #8e9eaa;
    font-size: 11px;
    letter-spacing: 0.5px;
}

.split-frequency strong {
    color: #e4ebef;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.split-up-button {
    width: 100%;
    height: 31px;
    margin-top: 7px;

    color: #d7e0e6;
    font-weight: 600;
}

.split-tx-input {
    margin-top: 7px;
}

.split-tx-input label {
    display: block;
    margin-bottom: 3px;

    color: #8e9eaa;
    font-size: 10px;
    letter-spacing: 0.5px;
}

.split-tx-input input {
    box-sizing: border-box;
    width: 100%;
    height: 30px;

    padding: 3px 7px;

    border: 1px solid #4b5b66;
    border-radius: 3px;

    background: #18232b;
    color: #e4ebef;

    font-family: inherit;
    font-size: 15px;
    text-align: right;
}

.split-tx-input input:focus {
    outline: none;
    border-color: #087dc5;
    box-shadow: 0 0 5px rgba(0, 170, 255, 0.25);
}

.split-button {
    width: 100%;
    height: 35px;
    margin-top: 8px;

    color: #f0dc94;
    font-weight: 600;
}

.split-button.split-on {
    border-color: #78c878;
    color: #b9f0b9;
    background: #20382a;
}

/* ============================================================
   MODE
   ============================================================ */

.mode-panel {
    padding: 7px 10px;
}

.mode-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 7px;
}

.mode-grid button {
    height: 36px;
}


/* ============================================================
   METERS
   ============================================================ */

.meter-row {
    height: 160px;

    display: grid;

    grid-template-columns:
        1.15fr
        1.15fr
        1.15fr
        1.15fr
        1.15fr
        1.1fr;

    gap: 7px;
}

.meter {
    padding: 7px 10px;
    text-align: center;
}

.meter-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .5px;
}

.analog-meter {
    position: relative;
    height: 83px;
    margin-top: 1px;
    overflow: hidden;
}

.meter-scale {
    position: absolute;
    top: 6px;
    left: 5%;
    right: 5%;

    display: flex;
    justify-content: space-between;

    font-size: 10px;
    color: #d6dde3;
}

.meter-arc {
    position: absolute;

    width: 84%;
    height: 90px;

    left: 8%;
    top: 26px;

    border-top: 3px solid #d9e0e5;
    border-radius: 50% 50% 0 0;

    box-shadow: 0 -2px 6px #ffffff30;
}

.meter-needle {
    position: absolute;

    left: 50%;
    bottom: 4px;

    width: 2px;
    height: 70px;

    background: #ff493b;

    transform-origin: bottom center;
    transform: rotate(-7deg);

    box-shadow: 0 0 7px #ff3322;
}

.power-needle {
    transform: rotate(-17deg);
}

.swr-needle {
    transform: rotate(-36deg);
}

.alc-needle {
    transform: rotate(-12deg);
}

.meter-value {
    font-size: 21px;
    font-weight: 600;
    color: #dceeff;
    line-height: 21px;
}

.meter-subvalue {
    color: #91a1ad;
    font-size: 11px;
}


/* ============================================================
   TRANSMIT
   ============================================================ */

.transmit-panel {
    padding: 7px 10px;
}

.transmit-content {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 13px;
    height: 116px;
}

.ptt-ring {
    width: 88px;
    height: 88px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 3px solid #ff4034;

    box-shadow:
        0 0 10px #ff301f,
        inset 0 0 20px #ff301f55;
}

.ptt-button {
    width: 68px;
    height: 68px;
    border-radius: 50%;

    background:
        radial-gradient(
            circle at 35% 30%,
            #48535a,
            #171d21 65%
        );

    font-size: 16px;
}

.tx-buttons {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.tx-buttons button {
    width: 90px;
    height: 26px;
}


/* ============================================================
   TX POWER
   ============================================================ */

.power-panel {
    padding: 7px 12px;
}

.power-number {
    text-align: right;
    font-size: 18px;
    margin: 4px 10px 7px 0;
}

.power-slider {
    width: 100%;
}

.slider-labels,
.scale {
    display: flex;
    justify-content: space-between;
    color: #8797a4;
    font-size: 10px;
    padding: 0 2px;
}


/* ============================================================
   CONTROL ROW
   ============================================================ */

.control-row {
    flex: 1;
    min-height: 195px;

    display: grid;

    grid-template-columns:
        1.15fr
        1.35fr
        1.55fr
        .65fr
        1.15fr;

    gap: 7px;
}

.control-panel {
    padding: 8px 10px;
}

.control-panel > .section-title {
    margin-bottom: 7px;
}


/* ============================================================
   FILTER
   ============================================================ */

.control-line {
    display: grid;

    grid-template-columns:
        62px
        1fr
        55px;

    align-items: center;
    gap: 7px;

    margin-bottom: 1px;
}

.control-line label,
.slider-control label,
.button-line label,
.dsp-line label {
    color: #e1e8ee;
    font-size: 12px;
}

.control-line input,
.slider-control input {
    margin: 0;
    width: 100%;
}

.control-line > span {
    text-align: right;
    color: #e1e5e9;
}

.control-panel .scale {
    margin-left: 69px;
    margin-right: 53px;
    margin-bottom: 6px;
}

.roofing {
    margin-top: 7px;
    grid-template-columns:
        62px
        repeat(3, 1fr);
}

.roofing button {
    height: 29px;
    font-size: 11px;
}


/* ============================================================
   DSP
   ============================================================ */

.dsp-line {
    display: grid;
    grid-template-columns: 78px 42px 1fr 30px 30px;
    align-items: center;
    column-gap: 6px;
    height: 29px;
}

.dsp-line label {
    color: #aebbc4;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.dsp-line .toggle-button {
    width: 42px;
    height: 22px;
    min-height: 22px;
    padding: 0;
    font-size: 9px;
    line-height: 20px;
}

.dsp-line strong {
    justify-self: end;
    min-width: 72px;
    color: #e4ebef;
    font-size: 11px;
    font-weight: 400;
    text-align: right;
    white-space: nowrap;
    letter-spacing: 0.2px;
}

.dsp-line .value-button {
    width: 28px;
    height: 22px;
    min-height: 22px;
    padding: 0;
    font-size: 12px;
    line-height: 20px;
}

/* ============================================================
   RF / AF
   ============================================================ */

.slider-control {
    display: grid;

    grid-template-columns:
        67px
        1fr
        30px;

    gap: 6px;

    align-items: center;

    height: 30px;
}

.slider-control span {
    text-align: right;
}

.button-line {
    display: grid;

    grid-template-columns:
        40px
        repeat(4, 1fr);

    gap: 4px;

    align-items: center;

    margin-top: 4px;
}

.button-line button {
    height: 28px;
    font-size: 10px;
}
/* ============================================================
   AGC - COMPACT HORIZONTAL
   ============================================================ */

.agc-panel {
    padding: 8px 10px;
}

.agc-panel .section-title {
    margin-bottom: 8px;
}

.agc-panel button {
    width: calc(25% - 4px);
    height: 30px;
    min-height: 30px;
    margin-right: 3px;
    font-size: 10px;
}

.agc-panel button:last-child {
    margin-right: 0;

}
/* ============================================================
   RIT / XIT
   ============================================================ */

.rit-line {
    height: 51px;

    display: grid;

    grid-template-columns:
        35px
        1fr
        35px;

    align-items: center;
    gap: 7px;

    border-bottom: 1px solid #293842;
}

.rit-line strong {
    text-align: right;
    font-size: 15px;
    font-weight: 400;
}

.rit-line .knob {
    width: 32px;
    height: 32px;
    border-radius: 50%;
}

.clear-button {
    float: right;
    margin-top: 8px;
    height: 29px;
    padding: 0 14px;
}


/* ============================================================
   FOOTER
   ============================================================ */

.statusbar {
    height: 32px;

    display: flex;
    align-items: center;
    gap: 22px;

    padding: 0 10px;

    border-top: 1px solid #263746;

    background:
        linear-gradient(
            180deg,
            #0b141c,
            #070c11
        );

    color: #8797a4;
    font-size: 11px;
}

.statusbar strong {
    color: #aab9c5;
}

.statusbar .status-dot {
    width: 9px;
    height: 9px;
    margin-right: 4px;
}

.footer-spacer {
    flex: 1;
}


/* ============================================================
   1280 x 700
   ============================================================ */

@media (max-height: 720px) {

    .topbar {
        height: 56px;
    }

    .console {
        height: calc(100vh - 88px);
        padding: 7px;
        gap: 6px;
    }

    .top-row {
        height: 183px;
    }

    .meter-row {
        height: 156px;
    }

    .control-row {
        min-height: 192px;
    }

    .frequency {
        font-size: 50px;
    }

    .analog-meter {
        height: 78px;
    }

    .meter-value {
        font-size: 20px;
    }

    .statusbar {
        height: 32px;
    }
}


/* ============================================================
   TOUCH
   ============================================================ */

@media (pointer: coarse) {

    button {
        min-height: 38px;
    }

    .big-button,
    .band-button {
        min-height: 40px;
    }

    input[type="range"] {
        height: 28px;
    }
}


/* ============================================================
   FILTER SLIDERS — SHACK-SERVER
   ============================================================ */

#filter-width,
#filter-shift {
    appearance: none;
    -webkit-appearance: none;
    height: 20px;
    background: transparent;
    cursor: pointer;
}

/* Track */
#filter-width::-webkit-slider-runnable-track,
#filter-shift::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 3px;
    background: linear-gradient(
        to right,
        #087dc5 0%,
        #087dc5 50%,
        #35434d 50%,
        #35434d 100%
    );
    border: 1px solid #4b5b66;
}

/* Knob */
#filter-width::-webkit-slider-thumb,
#filter-shift::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;

    width: 16px;
    height: 16px;

    margin-top: -7px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 8px rgba(0, 170, 255, 0.45);

    transition:
        transform 0.12s ease,
        box-shadow 0.12s ease;
}

#filter-width::-webkit-slider-thumb:hover,
#filter-shift::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    box-shadow:
        0 0 0 2px #00aaff,
        0 0 12px rgba(0, 170, 255, 0.65);
}

/* Firefox */
#filter-width::-moz-range-track,
#filter-shift::-moz-range-track {
    height: 4px;
    border-radius: 3px;
    background: #35434d;
    border: 1px solid #4b5b66;
}

#filter-width::-moz-range-progress,
#filter-shift::-moz-range-progress {
    height: 4px;
    border-radius: 3px;
    background: #087dc5;
}

#filter-width::-moz-range-thumb,
#filter-shift::-moz-range-thumb {
    width: 12px;
    height: 12px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 8px rgba(0, 170, 255, 0.45);
}

/* ============================================================
   RF / AF SLIDERS — SHACK-SERVER
   ============================================================ */

#rf-gain-slider,
#af-gain-slider {
    appearance: none;
    -webkit-appearance: none;
    height: 20px;
    background: transparent;
    cursor: pointer;
}

/* Track */
#rf-gain-slider::-webkit-slider-runnable-track,
#af-gain-slider::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 3px;
    background: linear-gradient(
        to right,
        #087dc5 0%,
        #087dc5 50%,
        #35434d 50%,
        #35434d 100%
    );
    border: 1px solid #4b5b66;
}

/* Knob */
#rf-gain-slider::-webkit-slider-thumb,
#af-gain-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;

    width: 16px;
    height: 16px;

    margin-top: -7px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 8px rgba(0, 170, 255, 0.45);

    transition:
        transform 0.12s ease,
        box-shadow 0.12s ease;
}

#rf-gain-slider::-webkit-slider-thumb:hover,
#af-gain-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    box-shadow:
        0 0 0 2px #00aaff,
        0 0 12px rgba(0, 170, 255, 0.65);
}

/* Firefox */
#rf-gain-slider::-moz-range-track,
#af-gain-slider::-moz-range-track {
    height: 4px;
    border-radius: 3px;
    background: #35434d;
    border: 1px solid #4b5b66;
}

#rf-gain-slider::-moz-range-progress,
#af-gain-slider::-moz-range-progress {
    height: 4px;
    border-radius: 3px;
    background: #087dc5;
}

#rf-gain-slider::-moz-range-thumb,
#af-gain-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 8px rgba(0, 170, 255, 0.45);
}

/* DSP — active state */
.dsp-line .toggle-button.dsp-on {
    background: #20382a;
    border-color: #78c878;
    color: #b9f0b9;
    box-shadow: 0 0 5px rgba(100, 210, 120, 0.18);
}

/* ============================================================
   TX POWER SLIDER — SHACK-SERVER
   ============================================================ */

.power-slider {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 22px;
    background: transparent;
    cursor: pointer;
}

/* Track */
.power-slider::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 3px;
    background: #35434d;
    border: 1px solid #4b5b66;
}

/* Round power knob */
.power-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;

    width: 18px;
    height: 18px;

    margin-top: -8px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 10px rgba(0, 170, 255, 0.45);

    transition:
        transform 0.12s ease,
        box-shadow 0.12s ease;
}

.power-slider::-webkit-slider-thumb:hover {
    transform: scale(1.12);
    box-shadow:
        0 0 0 2px #00aaff,
        0 0 14px rgba(0, 170, 255, 0.65);
}

/* Firefox */
.power-slider::-moz-range-track {
    height: 4px;
    border-radius: 3px;
    background: #35434d;
    border: 1px solid #4b5b66;
}

.power-slider::-moz-range-progress {
    height: 4px;
    border-radius: 3px;
    background: #087dc5;
}

.power-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;

    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;

    box-shadow:
        0 0 0 2px #087dc5,
        0 0 10px rgba(0, 170, 255, 0.45);
}

/* ============================================================
   TX POWER — ROUND DISPLAY
   ============================================================ */

.power-ring {
    width: 108px;
    height: 108px;
    margin: 2px auto 4px;

    border-radius: 50%;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    position: relative;

    background:
        radial-gradient(
            circle,
            #18232b 0%,
            #18232b 62%,
            #111a20 63%,
            #111a20 100%
        );

    border: 3px solid #087dc5;

    box-shadow:
        0 0 0 1px #4b5b66,
        0 0 12px rgba(0, 170, 255, 0.20),
        inset 0 0 12px rgba(0, 0, 0, 0.45);
}

.power-ring::before {
    content: "";
    position: absolute;

    inset: -6px;

    border-radius: 50%;

    border: 1px solid #35434d;
}

.power-ring-value {
    position: relative;

    color: #e4ebef;
    font-size: 20px;
    font-weight: 500;
    line-height: 1;
}

.power-ring-label {
    position: relative;

    margin-top: 5px;

    color: #78909c;
    font-size: 8px;
    letter-spacing: 1.2px;
}

.power-panel .power-slider {
    display: none;
}

.power-panel .slider-labels {
    margin-top: 3px;
}

/* MODE control — transparent TX red */
.vfo-control-badge.mode-control.active {
    background: rgba(214, 40, 40, 0.22);
    border-color: rgba(255, 70, 70, 0.75);
    color: #ff8a8a;
    box-shadow: inset 0 0 8px rgba(214, 40, 40, 0.10);
}

.vfo-control-badge.mode-control.active .badge-label {
    color: #e87878;
}

.vfo-control-badge.mode-control.active .badge-value {
    color: #ffaaaa;
}

/* MODE popup — hidden until MODE button is pressed */
.mode-popup {
    display: none;
}

/* MODE popup — open state */
.mode-popup.open {
    display: block;
}

/* MODE popup — anchored to clicked MODE button */
.mode-popup {
    position: fixed;
    z-index: 1000;
}

/* SPLIT compact layout */
.split-panel {
    overflow: hidden;
}

.split-frequency {
    margin-top: 3px;
    padding: 1px 4px;
}

.split-frequency strong {
    font-size: 16px;
}

.split-up-button {
    height: 28px;
    margin-top: 5px;
}

.split-tx-input {
    margin-top: 5px;
}

.split-tx-input label {
    margin-bottom: 2px;
}

.split-tx-input input {
    height: 27px;
}

.split-button {
    height: 31px;
    margin-top: 5px;
}

/* SPLIT two-column layout */
.split-frequencies {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 7px;
}

.split-frequencies .split-frequency {
    margin-top: 0;
}

.split-tx-control {
    display: grid;
    grid-template-columns: 105px 1fr;
    gap: 8px;
    margin-top: 6px;
}

.split-tx-control .split-up-button {
    margin-top: 0;
    height: 28px;
}

.split-tx-control input {
    box-sizing: border-box;
    width: 100%;
    height: 28px;

    padding: 3px 7px;

    border: 1px solid #4b5b66;
    border-radius: 3px;

    background: #18232b;
    color: #e4ebef;

    font-family: inherit;
    font-size: 15px;
    text-align: right;
}

.split-tx-control input:focus {
    outline: none;
    border-color: #087dc5;
    box-shadow: 0 0 5px rgba(0, 170, 255, 0.25);
}

.split-tx-control .split-up-button,
.split-tx-control input {
    box-sizing: border-box;
    height: 38px;
}

/* SPLIT VFO A/B buttons */
.split-panel .split-buttons {
    display: flex;
    justify-content: space-between;
    gap: 12px;
}

.split-panel .small-tx {
    width: 120px;
    height: 34px;
}


/* VFO A / B active state */
.split-panel .small-tx.active {
    border-color: #ff493b;
    color: #ff756a;
    background: #38171a;
}


/* ============================================================
   FINAL CONSOLE LAYOUT
   ============================================================ */

/* Top row: wider VFO panels, compact split, instruments */
.top-row {
    grid-template-columns:
        minmax(300px, 1fr)
        360px
        minmax(300px, 1fr)
        390px;
}

/* Compact control row */
.control-row {
    min-height: 150px;
}

/* Compact control panels */
.control-panel {
    padding: 6px 10px;
}

.control-panel > .section-title {
    margin-bottom: 4px;
}

/* Compact filter */
.control-line {
    margin-bottom: 0;
}

.control-panel .scale {
    margin-bottom: 3px;
}

/* Compact DSP */
.dsp-line {
    height: 25px;
}

/* Compact RF / AF */
.slider-control {
    height: 26px;
}

/* ============================================================
   FULL WIDTH TX POWER
   ============================================================ */

.power-panel {
    width: 100%;
    box-sizing: border-box;
}

/* Ring no longer used */
.power-panel .power-ring {
    display: none;
}

/* Large power value */
.power-panel .power-number {
    text-align: center;
    font-size: 20px;
    margin: 4px 0 8px;
}

/* Wide power slider */
.power-panel .power-slider {
    display: block;
    width: 100%;
    height: 30px;
}

/* Wide slider track */
.power-panel .power-slider::-webkit-slider-runnable-track {
    height: 7px;
    border-radius: 4px;
    background: linear-gradient(
        to right,
        #087dc5 0%,
        #087dc5 50%,
        #35434d 50%,
        #35434d 100%
    );
    border: 1px solid #4b5b66;
}

/* Larger power knob */
.power-panel .power-slider::-webkit-slider-thumb {
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;
    box-shadow:
        0 0 0 2px #087dc5,
        0 0 10px rgba(0, 170, 255, 0.50);
}

/* Firefox */
.power-panel .power-slider::-moz-range-track {
    height: 7px;
    border-radius: 4px;
    background: #35434d;
    border: 1px solid #4b5b66;
}

.power-panel .power-slider::-moz-range-progress {
    height: 7px;
    border-radius: 4px;
    background: #087dc5;
}

.power-panel .power-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #d7e0e6;
    background: #18232b;
    box-shadow:
        0 0 0 2px #087dc5,
        0 0 10px rgba(0, 170, 255, 0.50);
}

/* Power scale */
.power-panel .slider-labels {
    margin-top: 5px;
    padding: 0 2px;
}


/* ============================================================
   TX POWER - OWN FULL WIDTH ROW
   ============================================================ */

.power-row {
    width: 100%;
    display: block;
    margin-top: 7px;
}

.power-row .power-panel {
    width: 100%;
    box-sizing: border-box;
}


/* ============================================================
   ALIGN ALL ROWS TO FULL WIDTH
   ============================================================ */

/* VFO A / SPLIT / VFO B */
.top-row {
    grid-template-columns:
        minmax(300px, 1fr)
        360px
        minmax(300px, 1fr);
}

/* S-METER / POWER / SWR / ALC / TRANSMIT */
.meter-row {
    grid-template-columns:
        1.15fr 1.15fr 1.15fr 1.15fr 1.15fr;
}

/* FILTER / DSP / RF-AF / QUICK FUNCTIONS */
.control-row {
    grid-template-columns:
        1.15fr 1.35fr 1.55fr .65fr;
}


/* ============================================================
   VFO FREQUENCY INPUT
   ============================================================ */

.vfo-frequency-input {
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border: none;
    outline: none;
    color: #e8f0f5;
    font: inherit;
    font-size: 34px;
    font-weight: 700;
    text-align: center;
    font-family: inherit;
}

.vfo-frequency-input:focus {
    outline: none;
}


/* ============================================================
   VFO FREQUENCY INPUT - FIX
   ============================================================ */

.frequency:has(.vfo-frequency-input) {
    display: flex;
    align-items: center;
    justify-content: center;
}

.frequency .vfo-frequency-input {
    display: block;
    width: 100%;
    height: 48px;
    padding: 0;
    margin: 0;
    box-sizing: border-box;

    background: #111a20;
    border: 1px solid #087dc5;
    border-radius: 4px;

    color: #e8f0f5;
    font-size: 34px;
    font-weight: 700;
    line-height: 48px;
    text-align: center;

    outline: none;
    caret-color: #e8f0f5;
}

.frequency .vfo-frequency-input:focus {
    border-color: #3aaeff;
    box-shadow: 0 0 8px rgba(0, 170, 255, 0.25);
}


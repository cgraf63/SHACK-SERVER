#!/bin/bash

# ============================================================
# SHACK-SERVER SETUP
# Einfache Einrichtung für SHACK-SERVER
# ============================================================

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$PROJECT_DIR/.env"

cd "$PROJECT_DIR" || exit 1

# ------------------------------------------------------------
# Farben
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ------------------------------------------------------------
# Hilfsfunktionen
# ------------------------------------------------------------

pause() {
    echo
    read -r -p "Drücke ENTER zum Fortfahren ..."
}

ask() {
    local prompt="$1"
    local default="${2:-}"
    local answer

    if [ -n "$default" ]; then
        read -r -p "$prompt [$default]: " answer
        echo "${answer:-$default}"
    else
        read -r -p "$prompt: " answer
        echo "$answer"
    fi
}

ask_secret() {
    local prompt="$1"
    local answer

    read -r -s -p "$prompt: " answer
    echo
    echo "$answer"
}

ask_yes_no() {
    local prompt="$1"
    local default="${2:-n}"
    local answer

    if [ "$default" = "y" ]; then
        read -r -p "$prompt [J/n]: " answer
        answer="${answer:-j}"
    else
        read -r -p "$prompt [j/N]: " answer
        answer="${answer:-n}"
    fi

    case "$answer" in
        j|J|y|Y|ja|JA|yes|YES)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

get_env_value() {
    local key="$1"

    if [ ! -f "$ENV_FILE" ]; then
        echo ""
        return
    fi

    grep -E "^${key}=" "$ENV_FILE" 2>/dev/null |
        head -1 |
        cut -d '=' -f 2-
}

set_env_value() {
    local key="$1"
    local value="$2"
    local escaped_value

    escaped_value=$(printf '%s' "$value" | sed 's/[&/\]/\\&/g')

    if grep -qE "^${key}=" "$ENV_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${escaped_value}|" "$ENV_FILE"
    else
        printf '%s\n' "${key}=${value}" >> "$ENV_FILE"
    fi
}

# ------------------------------------------------------------
# Start
# ------------------------------------------------------------

clear

echo
echo "============================================================"
echo "                 SHACK-SERVER SETUP"
echo "============================================================"
echo
echo "Willkommen beim SHACK-SERVER Setup."
echo
echo "Dieser Assistent hilft dir bei der Grundeinrichtung."
echo
echo "Deine Stationsdaten werden später im Dashboard"
echo "unter Settings eingetragen."
echo

pause

# ============================================================
# SCHRITT 1 – NETZWERK
# ============================================================

clear

echo
echo "============================================================"
echo "                 SCHRITT 1 VON 3"
echo "                    NETZWERK"
echo "============================================================"
echo

if ip route | grep -q "default"; then

    echo -e "${GREEN}✓ Netzwerkverbindung erkannt.${NC}"
    echo

    IP_ADDRESS=$(hostname -I | awk '{print $1}')

    if [ -n "$IP_ADDRESS" ]; then
        echo "IP-Adresse: $IP_ADDRESS"
    else
        IP_ADDRESS="localhost"
    fi

else

    echo -e "${RED}✗ Keine Netzwerkverbindung erkannt.${NC}"
    echo
    echo "Bitte verbinde den Raspberry Pi mit Ethernet"
    echo "oder WLAN und starte das Setup erneut."
    echo

    exit 1
fi

pause

# ============================================================
# SCHRITT 2 – .ENV
# ============================================================

clear

echo
echo "============================================================"
echo "                 SCHRITT 2 VON 3"
echo "              INTERNET-DIENSTE"
echo "============================================================"
echo

if [ -f "$ENV_FILE" ]; then

    echo -e "${GREEN}✓ .env-Datei gefunden.${NC}"
    echo

    BACKUP_FILE="$ENV_FILE.backup-$(date +%Y%m%d-%H%M%S)"

    cp "$ENV_FILE" "$BACKUP_FILE"

    echo -e "${GREEN}✓ Backup erstellt:${NC}"
    echo "  $(basename "$BACKUP_FILE")"

else

    echo "Es wurde noch keine .env-Datei gefunden."
    echo
    touch "$ENV_FILE"
fi

chmod 600 "$ENV_FILE"

# ============================================================
# QRZ
# ============================================================

clear

echo
echo "============================================================"
echo "                    QRZ.COM"
echo "============================================================"
echo
echo "Die QRZ-Zugangsdaten werden nur für die"
echo "QRZ-Anbindung benötigt."
echo

OLD=$(get_env_value "QRZ_USER")
QRZ_USER=$(ask "QRZ Benutzername" "$OLD")
set_env_value "QRZ_USER" "$QRZ_USER"

echo

if [ -n "$(get_env_value "QRZ_PASSWORD")" ]; then
    echo "Ein QRZ-Passwort ist bereits gespeichert."
    echo "ENTER = bisheriges Passwort behalten."
fi

read -r -s -p "QRZ Passwort (ENTER = behalten): " QRZ_PASSWORD
echo

if [ -n "$QRZ_PASSWORD" ]; then
    set_env_value "QRZ_PASSWORD" "$QRZ_PASSWORD"
fi

echo

if [ -n "$(get_env_value "QRZ_API_KEY")" ]; then
    echo "Ein QRZ API-Key ist bereits gespeichert."
    echo "ENTER = bisherigen API-Key behalten."
fi

read -r -s -p "QRZ API-Key (ENTER = behalten): " QRZ_API_KEY
echo

if [ -n "$QRZ_API_KEY" ]; then
    set_env_value "QRZ_API_KEY" "$QRZ_API_KEY"
fi

# ============================================================
# DXSPIDER 1–4
# ============================================================

for NUM in 1 2 3 4; do

    clear

    echo
    echo "============================================================"
    echo "                    DXSPIDER $NUM VON 4"
    echo "============================================================"
    echo

    OLD_ENABLED=$(get_env_value "DXSPIDER${NUM}_ENABLED")

    if [ "$OLD_ENABLED" = "true" ]; then
        DEFAULT="y"
    else
        DEFAULT="n"
    fi

    if ask_yes_no "Diesen DXSpider aktivieren?" "$DEFAULT"; then

        set_env_value "DXSPIDER${NUM}_ENABLED" "true"

        OLD=$(get_env_value "DXSPIDER${NUM}_HOST")
        HOST=$(ask "Server" "$OLD")
        set_env_value "DXSPIDER${NUM}_HOST" "$HOST"

        OLD=$(get_env_value "DXSPIDER${NUM}_PORT")
        [ -z "$OLD" ] && OLD="7300"

        PORT=$(ask "Port" "$OLD")
        set_env_value "DXSPIDER${NUM}_PORT" "$PORT"

        OLD=$(get_env_value "DXSPIDER${NUM}_CALLSIGN")
        CALLSIGN=$(ask "Rufzeichen für diesen Server" "$OLD")
        set_env_value "DXSPIDER${NUM}_CALLSIGN" "$CALLSIGN"

        OLD_PASSWORD=$(get_env_value "DXSPIDER${NUM}_PASSWORD")

        if [ -n "$OLD_PASSWORD" ]; then
            echo "Ein Passwort ist bereits gespeichert."
            echo "ENTER = bisheriges Passwort behalten."
        fi

        read -r -s -p "Passwort (ENTER = behalten): " PASSWORD
        echo

        if [ -n "$PASSWORD" ]; then
            set_env_value "DXSPIDER${NUM}_PASSWORD" "$PASSWORD"
        fi

    else

        set_env_value "DXSPIDER${NUM}_ENABLED" "false"

        echo
        echo "DXSpider $NUM wird nicht verwendet."

    fi

    pause

done

# ============================================================
# HOLYCLUSTER
# ============================================================

clear

echo
echo "============================================================"
echo "                   HOLYCLUSTER"
echo "============================================================"
echo

OLD_ENABLED=$(get_env_value "HOLYCLUSTER_ENABLED")

if [ "$OLD_ENABLED" = "true" ]; then
    DEFAULT="y"
else
    DEFAULT="n"
fi

if ask_yes_no "HolyCluster aktivieren?" "$DEFAULT"; then

    set_env_value "HOLYCLUSTER_ENABLED" "true"

    OLD=$(get_env_value "HOLYCLUSTER_HOST")
    HOST=$(ask "Server" "$OLD")
    set_env_value "HOLYCLUSTER_HOST" "$HOST"

    OLD=$(get_env_value "HOLYCLUSTER_PORT")
    [ -z "$OLD" ] && OLD="7300"

    PORT=$(ask "Port" "$OLD")
    set_env_value "HOLYCLUSTER_PORT" "$PORT"

    OLD=$(get_env_value "HOLYCLUSTER_CALLSIGN")
    CALLSIGN=$(ask "Rufzeichen für diesen Server" "$OLD")
    set_env_value "HOLYCLUSTER_CALLSIGN" "$CALLSIGN"

    OLD_PASSWORD=$(get_env_value "HOLYCLUSTER_PASSWORD")

    if [ -n "$OLD_PASSWORD" ]; then
        echo "Ein Passwort ist bereits gespeichert."
        echo "ENTER = bisheriges Passwort behalten."
    fi

    read -r -s -p "Passwort (ENTER = behalten): " PASSWORD
    echo

    if [ -n "$PASSWORD" ]; then
        set_env_value "HOLYCLUSTER_PASSWORD" "$PASSWORD"
    fi

else

    set_env_value "HOLYCLUSTER_ENABLED" "false"

    echo
    echo "HolyCluster wird nicht verwendet."

fi

pause

# ============================================================
# DX SUMMIT
# ============================================================

clear

echo
echo "============================================================"
echo "                     DX SUMMIT"
echo "============================================================"
echo

OLD_ENABLED=$(get_env_value "DXSUMMIT_ENABLED")

if [ "$OLD_ENABLED" = "true" ]; then
    DEFAULT="y"
else
    DEFAULT="n"
fi

if ask_yes_no "DX Summit aktivieren?" "$DEFAULT"; then

    set_env_value "DXSUMMIT_ENABLED" "true"

    OLD=$(get_env_value "DXSUMMIT_HOST")
    [ -z "$OLD" ] && OLD="www.dxsummit.fi"

    HOST=$(ask "Server" "$OLD")
    set_env_value "DXSUMMIT_HOST" "$HOST"

else

    set_env_value "DXSUMMIT_ENABLED" "false"

    echo
    echo "DX Summit wird nicht verwendet."

fi

pause

# ============================================================
# SCHRITT 3 – DASHBOARD
# ============================================================

clear

echo
echo "============================================================"
echo "                 SCHRITT 3 VON 3"
echo "                 STATIONS-DATEN"
echo "============================================================"
echo
echo "Die Internet-Dienste wurden gespeichert."
echo
echo "Die Stationsdaten werden im Dashboard eingetragen."
echo
echo "Bitte öffne:"
echo
echo -e "    ${CYAN}https://${IP_ADDRESS}/settings.html${NC}"
echo
echo "und trage dort ein:"
echo
echo "    • Rufzeichen"
echo "    • Operator"
echo "    • Locator"
echo "    • Club"
echo

# ============================================================
# ABSCHLUSS
# ============================================================

echo
echo "============================================================"
echo "                       FERTIG"
echo "============================================================"
echo
echo -e "${GREEN}✓ SHACK-SERVER wurde konfiguriert.${NC}"
echo
echo "Die .env-Datei wurde geschützt:"
echo
echo "    chmod 600 .env"
echo
echo "Ein Backup der vorherigen .env wurde erstellt."
echo
echo "Dashboard:"
echo
echo -e "    ${CYAN}https://${IP_ADDRESS}/settings.html${NC}"
echo
echo "============================================================"
echo

exit 0

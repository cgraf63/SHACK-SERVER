#!/bin/bash
# ============================================================
# SHACK-SERVER - where to set it up
#
# The setup moved to the browser: http://<pi>:3000/setup
# (station, transceiver, QRZ.com). This script only checks the
# network and shows the address.
#
# Optional: --port 8080   changes the HTTP port (PORT in .env)
# ============================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$PROJECT_DIR/.env"


get_port() {

    local port=""
    if [ -f "$ENV_FILE" ]; then
        port="$( (grep -E '^PORT=' "$ENV_FILE" || true) | tail -n 1 | cut -d= -f2- | tr -d '"[:space:]')"
    fi
    echo "${port:-3000}"

}


# --port N: write PORT to .env (restart needed)
if [ "${1:-}" = "--port" ]; then

    new_port="${2:-}"

    if ! [[ "$new_port" =~ ^[0-9]+$ ]] || [ "$new_port" -lt 1 ] || [ "$new_port" -gt 65535 ]; then
        echo "Usage: $0 --port 1-65535"
        exit 1
    fi

    touch "$ENV_FILE"
    chmod 600 "$ENV_FILE"

    if grep -qE '^PORT=' "$ENV_FILE"; then
        sed -i "s|^PORT=.*|PORT=$new_port|" "$ENV_FILE"
    else
        printf 'PORT=%s\n' "$new_port" >> "$ENV_FILE"
    fi

    echo "PORT=$new_port saved. Restart: pm2 restart shack-server"
    exit 0

fi


echo
echo "============================================================"
echo "                    SHACK-SERVER setup"
echo "============================================================"
echo

HOST_NAME="$(hostname 2>/dev/null || echo raspberrypi)"
IP_ADDRESS="$(hostname -I 2>/dev/null | awk '{print $1}')"
PORT="$(get_port)"

echo "Host name:  $HOST_NAME"
echo "IP address: ${IP_ADDRESS:-not found}"

if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
    echo "Internet:   OK"
else
    echo "Internet:   NOT REACHABLE - check the network first"
fi

echo
echo "The setup is done in the browser (station, transceiver,"
echo "QRZ.com - four short steps):"
echo
[ -n "$IP_ADDRESS" ] && echo "  http://$IP_ADDRESS:$PORT/setup"
echo "  http://${HOST_NAME,,}.local:$PORT/setup"
echo
echo "Everything else (log uploads, LoTW, backup, notifications ...)"
echo "is in Settings - the assistant links to it at the end."
echo
echo "Change the HTTP port:  $0 --port 8080"
echo

#!/bin/bash

# ============================================================
# SHACK-SERVER Setup
# Einfache Erstkonfiguration für SHACK-SERVER
# ============================================================

set -u

clear

echo
echo "============================================================"
echo "                 SHACK-SERVER SETUP"
echo "============================================================"
echo
echo "Willkommen beim SHACK-SERVER Setup."
echo
echo "Dieser Assistent hilft dir bei der Grundeinrichtung."
echo
echo "Wir prüfen zuerst die Netzwerkverbindung."
echo
read -r -p "Drücke ENTER zum Fortfahren ..."

clear

echo
echo "============================================================"
echo "                 SCHRITT 1 VON 3"
echo "                    NETZWERK"
echo "============================================================"
echo

if ip route | grep -q "default"; then
    echo "✓ Netzwerkverbindung erkannt."
    echo

    IP_ADDRESS=$(hostname -I | awk '{print $1}')

    if [ -n "$IP_ADDRESS" ]; then
        echo "  IP-Adresse: $IP_ADDRESS"
    fi
else
    echo "✗ Keine Netzwerkverbindung erkannt."
    echo
    echo "Bitte verbinde den Raspberry Pi mit"
    echo "Ethernet oder WLAN."
    echo
    echo "Danach kannst du dieses Setup erneut starten."
    echo
    exit 1
fi

echo
read -r -p "Drücke ENTER zum Fortfahren ..."

clear

echo
echo "============================================================"
echo "                 SCHRITT 2 VON 3"
echo "              INTERNET-DIENSTE"
echo "============================================================"
echo

if [ -f ".env" ]; then
    echo "✓ Eine .env-Datei wurde bereits gefunden."
    echo
    echo "Die vorhandenen Zugangsdaten werden zunächst"
    echo "NICHT verändert."
else
    echo "• Es wurde noch keine .env-Datei gefunden."
    echo
    echo "Sie wird im nächsten Schritt eingerichtet."
fi

echo
read -r -p "Drücke ENTER zum Fortfahren ..."

clear

echo
echo "============================================================"
echo "                 SCHRITT 3 VON 3"
echo "                 SHACK-EINSTELLUNGEN"
echo "============================================================"
echo
echo "Die Stationsdaten werden im SHACK-SERVER Dashboard"
echo "eingetragen."
echo
echo "Öffne nach Abschluss:"
echo
echo "    https://$IP_ADDRESS/settings.html"
echo
echo "Dort kannst du eintragen:"
echo
echo "    • Rufzeichen"
echo "    • Operator"
echo "    • Locator"
echo "    • Club"
echo

echo "============================================================"
echo "                 SETUP VORBEREITET"
echo "============================================================"
echo
echo "Das Setup-Grundgerüst funktioniert."
echo
echo "Die eigentliche Konfiguration von QRZ, DXSpider,"
echo "HolyCluster und DX Summit wird im nächsten Schritt"
echo "hinzugefügt."
echo
